[Unit]
Description=Mapache remote VM workspace runtime
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=0
ConditionPathExists=/opt/mapache/payload/session-runner/server.js
ConditionPathExists=/opt/mapache/payload/runtime/bin/node

[Service]
Type=simple
User=mapache
Group=mapache
WorkingDirectory=/var/lib/mapache/workspace/workspace
Environment=NODE_ENV=production
Environment=MAPACHE_RUNTIME_PROVIDER=remote-libvirt
Environment=WORKSPACE_STORAGE_MODE=retained-disk
Environment=MAPACHE_RETAINED_DISK_ROOT=/var/lib/mapache/workspace
Environment=WORKSPACE_DIR=/var/lib/mapache/workspace/workspace
Environment=HOME=/var/lib/mapache/workspace/home
Environment=MAPACHE_HOME_DIR=/var/lib/mapache/workspace/home
Environment=MAPACHE_USER_BIN_DIR=/var/lib/mapache/workspace/home/.local/bin
Environment=MAPACHE_AGENT_UI_VERSION=pi-web-ui-v1
Environment=MAPACHE_PI_WEB_UI_ROOT=/opt/mapache/payload/pi-web-ui
Environment=PI_WEB_MCP_ADAPTER_PATH=/opt/mapache/payload/pi-mcp-adapter/index.ts
Environment=RUNNER_BIND_HOST=private-guest-interface
Environment=PORT=8080
Environment='RUNNER_CAPABILITIES={"terminal":true,"preview":false,"previewQa":false,"functions":false,"chrome":true}'
Environment=CHROME_PROFILE_DIR=/var/lib/mapache/workspace/browser/profile
Environment=PREVIEW_ENABLED=false
EnvironmentFile=-/etc/mapache-vm/guest.env
ExecStart=/usr/local/libexec/mapache-guest-bootstrap
Restart=on-failure
RestartSec=5
TimeoutStopSec=15
KillMode=mixed
NoNewPrivileges=true
PrivateDevices=true
ProtectHome=false
ReadWritePaths=/var/lib/mapache/workspace
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
