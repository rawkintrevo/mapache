+	/** Get the model and provider-key choices from the client that most recently
+	 * selected a model for this project. Browserless runs use their own client ID, so they cannot use
+	 * the per-client getter above to inherit the workspace's saved selection. */
+	getMostRecentlySelectedProjectSelection(cwd: string): {
+		modelId: string;
+		providerKeys: Record<string, string>;
+	} | undefined {
+		const candidates = Object.entries(this.load()).flatMap(([clientId, state], index) => {
+			if (clientId === "__settings__") return [];
+			const modelId = state.projectModels?.[cwd]?.trim();
+			if (!modelId) return [];
+			const projectLastUsed = state.projects?.find((project) => project.path === cwd)?.lastUsed;
+			const modelLastSelected = state.projectModelUpdatedAt?.[cwd];
+			const recency = typeof modelLastSelected === "number" && Number.isFinite(modelLastSelected)
+				? modelLastSelected
+				: typeof projectLastUsed === "number" && Number.isFinite(projectLastUsed) ? projectLastUsed : 0;
+			return [{
+				modelId,
+				providerKeys: state.projectProviderKeys?.[cwd] ?? {},
+				lastUsed: recency,
+				index,
+			}];
+		});
+		candidates.sort((left, right) => right.lastUsed - left.lastUsed || right.index - left.index);
+		const selected = candidates[0];
+		return selected ? {modelId: selected.modelId, providerKeys: selected.providerKeys} : undefined;
+	}
