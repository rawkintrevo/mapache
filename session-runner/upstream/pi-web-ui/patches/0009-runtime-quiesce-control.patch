diff --git a/tests/unit/quiesce.test.ts b/tests/unit/quiesce.test.ts
new file mode 100644
index 0000000..5fccccf
--- /dev/null
+++ b/tests/unit/quiesce.test.ts
@@ -0,0 +1,94 @@
+import { performance } from "node:perf_hooks";
+import { describe, expect, it, vi } from "vitest";
+import { ClientSession } from "../../server/agent-service.js";
+
+function delay(ms: number): Promise<void> {
+	return new Promise((resolve) => setTimeout(resolve, ms));
+}
+
+function makeClient(session: Record<string, unknown>, timeoutGoal?: () => Promise<void>) {
+	let idle = false;
+	const conv = {
+		id: "c1",
+		session,
+		runtime: { session },
+		toolStartTimes: new Map(),
+		queueSteering: ["queued steer"],
+		queueFollowUp: ["queued follow-up"],
+		terminals: { killAll: vi.fn() },
+		promptedSinceActive: false,
+		lastActiveAt: 0,
+		lastSdkEventAt: 0,
+		stallNoticed: false,
+		title: "New chat",
+	};
+	Object.defineProperty(session, "isStreaming", { get: () => !idle, configurable: true });
+	Object.defineProperty(session, "isIdle", { get: () => idle, configurable: true });
+	(session as any).abort = async () => {
+		await delay(30);
+		idle = true;
+	};
+	const client = Object.create(ClientSession.prototype) as ClientSession & Record<string, any>;
+	Object.assign(client, {
+		activeId: "c1",
+		convs: new Map([["c1", conv]]),
+		goalSvc: { quiesce: timeoutGoal || (async () => {}) },
+		bashKills: new Set(),
+		bg: { killAll: async () => [] },
+		disposed: false,
+		sinks: new Set(),
+		pendingNotices: [],
+		flushSnapshot: vi.fn(),
+		cancelPendingQuestions: vi.fn(),
+		isQuiesced: () => false,
+	});
+	return { client, conv, session };
+}
+
+describe("agent quiesce", () => {
+	it("waits for a delayed abort before reporting that writers stopped", async () => {
+		const { client, conv, session } = makeClient({
+			clearQueue: vi.fn(),
+			pendingMessageCount: 0,
+			abort: vi.fn(),
+		});
+		const startedAt = performance.now();
+		const drained = await client.quiesce(100);
+
+		expect(drained).toBe(true);
+		expect(performance.now() - startedAt).toBeGreaterThanOrEqual(25);
+		expect(session.clearQueue).toHaveBeenCalledOnce();
+		expect(conv.terminals.killAll).toHaveBeenCalledOnce();
+		expect(client.flushSnapshot).toHaveBeenCalledWith(true);
+	});
+
+	it("returns a bounded failure when an agent refuses to stop", async () => {
+		const { client, session } = makeClient({
+			clearQueue: vi.fn(),
+			pendingMessageCount: 0,
+			abort: vi.fn(() => new Promise<void>(() => {})),
+		});
+		Object.defineProperty(session, "isStreaming", { get: () => true, configurable: true });
+		Object.defineProperty(session, "isIdle", { get: () => false, configurable: true });
+
+		const startedAt = performance.now();
+		const drained = await client.quiesce(30);
+
+		expect(drained).toBe(false);
+		expect(performance.now() - startedAt).toBeLessThan(300);
+	});
+
+	it("rejects a direct prompt before slash or model work can execute", async () => {
+		const prompt = vi.fn(async () => {});
+		const { client, conv } = makeClient({
+			clearQueue: vi.fn(),
+			pendingMessageCount: 0,
+			prompt,
+		});
+		client.isQuiesced = () => true;
+		await client.prompt("/arbitrary-extension-command");
+
+		expect(prompt).not.toHaveBeenCalled();
+		expect(conv.promptedSinceActive).toBe(false);
+	});
+});
