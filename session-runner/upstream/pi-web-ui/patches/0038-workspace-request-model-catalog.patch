@@ -1228,6 +1228,27 @@ export class ClientSession {
 	get runtime(): AgentSessionRuntime {
 		return this.conv.runtime;
 	}
+
+	modelCatalog(): { providerId: string; modelId: string; name: string; available: boolean; input?: string[] }[] {
+		const runtime = this.sharedModelRuntime;
+		if (!runtime) return [];
+		const models: { providerId: string; modelId: string; name: string; available: boolean; input?: string[] }[] = [];
+		for (const provider of runtime.getProviders()) {
+			const available = runtime.hasConfiguredAuth(provider.id);
+			for (const model of runtime.getModels(provider.id)) {
+				models.push({
+					providerId: provider.id,
+					modelId: model.id,
+					name: model.name ?? model.id,
+					available,
+					...(Array.isArray(model.input) ? { input: model.input.map(String).slice(0, 8) } : {}),
+				});
+			}
+		}
+		return models.sort((a, b) => a.providerId === b.providerId
+			? a.name.localeCompare(b.name)
+			: a.providerId.localeCompare(b.providerId));
+	}
 	/** Session of the active conversation. */
 	get session(): AgentSession {
 		return this.conv.session;
