index aac0d52..65d8dd6 100644
--- a/server/managed.ts
+++ b/server/managed.ts
@@ -38,6 +38,15 @@ export const MANAGED_MESSAGES = [
 
 export type ManagedMessage = (typeof MANAGED_MESSAGES)[number];
 
+/** Commands that would let the upstream app become a second credential owner. */
+export const MANAGED_CREDENTIAL_MESSAGES = [
+	"set_provider_api_key",
+	"clear_provider_api_key",
+	"add_provider_key",
+	"activate_provider_key",
+	"remove_provider_key",
+] as const;
+
 /**
  * Whether this instance is managed from outside.
  *
@@ -62,3 +71,35 @@ export function managedRefusal(type: string, managed: boolean): string | null {
 	if (!(MANAGED_MESSAGES as readonly string[]).includes(type)) return null;
 	return "This instance is managed: updates and plugin installs are handled by whoever deploys it (PI_WEB_MANAGED=1).";
 }
+
+/**
+ * Reject credential-bearing requests while leaving model metadata operations
+ * available. `save_model_config` and `fetch_models` are safe only when the
+ * request contains no new secret; the saved server-side secret/config is
+ * reused by those read/metadata paths.
+ */
+export function managedCredentialRefusal(type: string, managed: boolean, payload?: unknown): string | null {
+	if (!managed) return null;
+	if ((MANAGED_CREDENTIAL_MESSAGES as readonly string[]).includes(type)) return credentialRefusalText();
+
+	const message = payload && typeof payload === "object" ? (payload as Record<string, unknown>) : {};
+	if (type === "fetch_models" && hasNonEmptySecret(message.apiKey)) return credentialRefusalText();
+	if (type === "save_model_config") {
+		const config =
+			message.config && typeof message.config === "object" ? (message.config as Record<string, unknown>) : {};
+		if (hasNonEmptySecret(config.apiKey) || hasNonEmptyHeaders(config.headers)) return credentialRefusalText();
+	}
+	return null;
+}
+
+function hasNonEmptySecret(value: unknown): boolean {
+	return typeof value === "string" ? value.trim().length > 0 : value != null;
+}
+
+function hasNonEmptyHeaders(value: unknown): boolean {
+	return Boolean(value && typeof value === "object" && !Array.isArray(value) && Object.keys(value).length > 0);
+}
+
+function credentialRefusalText(): string {
+	return "This instance is managed: provider credentials, OAuth, and secret headers are handled by Mapache. Model selection and non-secret model metadata remain available.";
+}
