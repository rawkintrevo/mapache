+				try {
+					finish(JSON.parse(buf.slice(0, nl)) as ControlStatus);
+				} catch {
+					finish(null);
+				}
+			}
+		});
+		sock.on("error", () => finish(null));
+		sock.on("close", () => finish(null));
+	});
