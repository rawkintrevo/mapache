+		const emitNotice = vi.fn();
+		const session = { resumeGoal, emitNotice } as unknown as DispatchSession;
+		expect(handlePlanAndGoalMessage({ type: "resume_goal" }, session)).toBe(true);
+		await vi.waitFor(() => expect(emitNotice).toHaveBeenCalledOnce());
+		expect(resumeGoal).toHaveBeenCalledOnce();
+		expect(JSON.stringify(emitNotice.mock.calls)).not.toContain("private internal detail");
+	});
+	it("rejects unsupported runtime resume instead of silently accepting it", () => {
+		expect(() => handlePlanAndGoalMessage({ type: "resume_goal" }, {} as DispatchSession)).toThrow(
+			"goal_resume_unsupported",
+		);
+	});
+});
diff --git a/tests/unit/managed-model-catalog.test.ts b/tests/unit/managed-model-catalog.test.ts
new file mode 100644
index 0000000..f56ab79
--- /dev/null
+++ b/tests/unit/managed-model-catalog.test.ts
@@ -0,0 +1,142 @@
+import { describe, expect, it, vi } from "vitest";
+import { mkdtempSync, writeFileSync, rmSync } from "node:fs";
+import { join } from "node:path";
+import { tmpdir } from "node:os";
+import { ModelRuntime } from "@earendil-works/pi-coding-agent";
+import { createManagedModelCatalog } from "../../server/managed-model-catalog.js";
+
+function fixture() {
+	const runtime = {
+		refresh: vi.fn(async () => ({})),
+		getProviders: () => [{ id: "configured" }, { id: "unconfigured" }],
+		getModels: (provider: string) => [
+			{ id: `${provider}/model`, name: "Model", input: ["text", "image"], apiKey: "private-key" },
+		],
+		hasConfiguredAuth: (provider: string) => provider === "configured",
+	};
+	const createRuntime = vi.fn(async () => runtime as any);
+	const catalog = createManagedModelCatalog({
+		agentDir: "/agent",
+		savedSelection: () => "stale/model/name",
+		isQuiesced: () => false,
+		createRuntime,
+		timeoutMs: 20,
+	});
+	return { runtime, createRuntime, catalog };
+}
+
+describe("managed runtime model catalog", () => {
+	it("reads a custom slash-ID model from the real installed SDK without returning credentials", async () => {
+		const agentDir = mkdtempSync(join(tmpdir(), "managed-model-catalog-"));
+		try {
+			writeFileSync(join(agentDir, "auth.json"), "{}");
+			writeFileSync(
+				join(agentDir, "models.json"),
+				JSON.stringify({
+					providers: {
+						"fixture-provider": {
+							baseUrl: "http://127.0.0.1:1/v1",
+							api: "openai-completions",
+							apiKey: "fixture-not-a-real-key",
+							models: [
+								{
+									id: "organization/family/model",
+									name: "Fixture slash model",
+									reasoning: false,
+									input: ["text"],
+									cost: { input: 0, output: 0, cacheRead: 0, cacheWrite: 0 },
+									contextWindow: 8192,
+									maxTokens: 1024,
+								},
+							],
+						},
+					},
+				}),
+			);
+			const catalog = createManagedModelCatalog({
+				agentDir,
+				allowNetwork: false,
+				isQuiesced: () => false,
+				savedSelection: () => "fixture-provider/organization/family/model",
+				createRuntime: (paths) =>
+					ModelRuntime.create({ ...paths, modelsStorePath: join(agentDir, "catalog.json"), allowModelNetwork: false }),
+			});
+			const result = await catalog.workspaceRequestModels();
+			expect(result.ok).toBe(true);
+			expect(result.models).toContainEqual({
+				providerId: "fixture-provider",
+				modelId: "organization/family/model",
+				name: "Fixture slash model",
+				available: true,
+				input: ["text"],
+			});
+			expect(result.savedModelSelection).toEqual({
+				providerId: "fixture-provider",
+				modelId: "organization/family/model",
+			});
+			expect(JSON.stringify(result)).not.toContain("fixture-not-a-real-key");
+		} finally {
+			rmSync(agentDir, { recursive: true, force: true });
+		}
+	});
+	it("returns safe full catalog rows including unavailable providers and stale saved selections", async () => {
+		const { catalog, createRuntime } = fixture();
+		const result = await catalog.workspaceRequestModels();
+		expect(result).toMatchObject({
+			ok: true,
+			models: [
+				{ providerId: "configured", available: true },
+				{ providerId: "unconfigured", available: false },
+			],
+			savedModelSelection: { providerId: "stale", modelId: "model/name" },
+		});
+		expect(JSON.stringify(result)).not.toContain("private-key");
+		expect(createRuntime).toHaveBeenCalledWith({ authPath: "/agent/auth.json", modelsPath: "/agent/models.json" });
+	});
+	it("shares discovery in flight but reloads the SDK after a completed query", async () => {
+		const { catalog, createRuntime } = fixture();
+		await Promise.all([catalog.workspaceRequestModels(), catalog.workspaceRequestModels()]);
+		expect(createRuntime).toHaveBeenCalledTimes(1);
+		await catalog.workspaceRequestModels();
+		expect(createRuntime).toHaveBeenCalledTimes(2);
+	});
+	it("returns sanitized initialization and catalog errors and allows retry", async () => {
+		const { catalog, createRuntime, runtime } = fixture();
+		createRuntime.mockRejectedValueOnce(new Error("secret-token"));
+		expect(await catalog.workspaceRequestModels()).toMatchObject({
+			ok: false,
+			retryable: true,
+			error: "workspace_request_model_client_initialization_failed",
+			stage: "client_initialization",
+		});
+		runtime.refresh.mockRejectedValueOnce(new Error("secret-token"));
+		expect(await catalog.workspaceRequestModels()).toMatchObject({
+			ok: false,
+			error: "workspace_request_model_catalog_failed",
+		});
+		expect(await catalog.workspaceRequestModels()).toMatchObject({ ok: true });
+	});
+	it("bounds a hung initialization and reuses it across retries", async () => {
+		const { catalog, createRuntime } = fixture();
+		createRuntime.mockImplementation(() => new Promise(() => {}));
+		for (let i = 0; i < 2; i++) {
+			expect(await catalog.workspaceRequestModels()).toMatchObject({
+				ok: false,
+				error: "workspace_request_model_discovery_timeout",
+				retryable: true,
+			});
+		}
+		expect(createRuntime).toHaveBeenCalledTimes(1);
+	});
+	it("rejects discovery during drain without initializing the SDK", async () => {
+		const createRuntime = vi.fn();
+		const catalog = createManagedModelCatalog({
+			agentDir: "/agent",
+			savedSelection: () => undefined,
+			isQuiesced: () => true,
+			createRuntime,
+		});
+		expect(await catalog.workspaceRequestModels()).toMatchObject({ ok: false, error: "server_quiesced" });
+		expect(createRuntime).not.toHaveBeenCalled();
+	});
+});
diff --git a/tests/unit/managed-reference.test.ts b/tests/unit/managed-reference.test.ts
new file mode 100644
index 0000000..02cd1a7
--- /dev/null
+++ b/tests/unit/managed-reference.test.ts
@@ -0,0 +1,130 @@
+import { mkdtempSync, readFileSync, rmSync, writeFileSync } from "node:fs";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import { afterEach, beforeEach, describe, expect, it, vi } from "vitest";
+import {
+	DefaultResourceLoader,
+	ExtensionRunner,
+	SessionManager,
+	type BeforeAgentStartEvent,
+	type ModelRegistry,
+} from "@earendil-works/pi-coding-agent";
+import { MAPACHE_REFERENCE_PATH, withManagedReference } from "../../server/managed-reference.js";
+
+const reference = "# Mapache operating reference\nUse localhost:port in managed Chrome.";
+const original = "SYSTEM.md instructions\n\nAvailable tools: read\nProject AGENTS.md\nUser APPEND_SYSTEM.md";
+const event = (systemPrompt = original): BeforeAgentStartEvent => ({
+	type: "before_agent_start",
+	messageType: "user",
+	prompt: "user request",
+	systemPrompt,
+	systemPromptOptions: { cwd: root, selectedTools: [], hiddenTools: [], toolSnippets: {}, toolGuidelines: {}, promptGuidelines: [], appendSystemPrompt: "", sections: {}, contextFiles: [], skills: [] },
+});
+let root: string;
+let path: string;
+beforeEach(() => {
+	root = mkdtempSync(join(tmpdir(), "managed-reference-"));
+	path = join(root, "mapache.md");
+	writeFileSync(path, `\n${reference}\n`);
+});
+afterEach(() => {
+	vi.restoreAllMocks();
+	rmSync(root, { recursive: true, force: true });
+});
+
+function wrap(compose: Parameters<typeof withManagedReference>[0] = () => undefined) {
+	return withManagedReference(compose, { PI_WEB_MANAGED: "1" }, path);
+}
+
+describe("managed operating reference", () => {
+	it("appends exactly once while preserving all existing instructions and repeated turns", () => {
+		const handler = wrap();
+		const expected = `${original}\n\n${reference}`;
+		expect(handler(event())?.systemPrompt).toBe(expected);
+		expect(handler(event())?.systemPrompt).toBe(expected);
+		// No override needed when a chained prompt already includes the reference.
+		expect(handler(event(expected))).toBeUndefined();
+	});
+
+	it("appends after custom composition even when it omits the append token", () => {
+		const composed = "Custom composer instructions\nProject rules";
+		const message = { customType: "example", content: "retain", display: false };
+		const handler = wrap(() => ({ systemPrompt: composed, message }));
+		expect(handler(event())).toEqual({ systemPrompt: `${composed}\n\n${reference}`, message });
+	});
+
+	it.each(["append", "replace", "replace with SYSTEM.md", "empty template"])(
+		"preserves the existing %s template result",
+		(mode) => {
+			const composed = mode === "empty template" ? original : `${mode} role\nProject rules\nUser append`;
+			const handler = wrap(() => (mode === "empty template" ? undefined : { systemPrompt: composed }));
+			expect(handler(event())?.systemPrompt).toBe(`${composed}\n\n${reference}`);
+		},
+	);
+
+	it.each([{}, { PI_WEB_MANAGED: "0" }, { PI_WEB_MANAGED: "false" }])(
+		"does not read files or alter the composer when unmanaged/disabled: %j",
+		(env) => {
+			const compose = () => ({ systemPrompt: "unchanged" });
+			const warn = vi.spyOn(console, "warn").mockImplementation(() => {});
+			expect(withManagedReference(compose, env, join(root, "missing"))).toBe(compose);
+			expect(warn).not.toHaveBeenCalled();
+		},
+	);
+
+	it.each(["missing", "empty"])("keeps existing prompt for %s reference with a safe warning", (kind) => {
+		if (kind === "missing") rmSync(path);
+		else writeFileSync(path, " \n\t");
+		const warn = vi.spyOn(console, "warn").mockImplementation(() => {});
+		const compose = () => ({ systemPrompt: original });
+		expect(wrap(compose)).toBe(compose);
+		expect(warn).toHaveBeenCalledOnce();
+		expect(warn.mock.calls[0][0]).not.toContain(path);
+	});
+
+	it("loads fresh image content when a runtime is recreated/resumed", () => {
+		const first = wrap();
+		writeFileSync(path, "Updated image reference");
+		const resumed = wrap();
+		expect(first(event())?.systemPrompt).toContain(reference);
+		expect(resumed(event())?.systemPrompt).toBe(`${original}\n\nUpdated image reference`);
+	});
+
+	it("uses the supported SDK hook and preserves earlier extension instructions without a model call", async () => {
+		const loader = new DefaultResourceLoader({
+			cwd: root,
+			agentDir: root,
+			noExtensions: true,
+			noSkills: true,
+			noPromptTemplates: true,
+			extensionFactories: [
+				(pi) => {
+					pi.on("before_agent_start", (e) => ({ systemPrompt: `${e.systemPrompt}\nEarlier extension` }));
+					pi.on("before_agent_start", wrap());
+				},
+			],
+		});
+		await loader.reload();
+		const loaded = loader.getExtensions();
+		expect(loaded.errors).toEqual([]);
+		const runner = new ExtensionRunner(
+			loaded.extensions,
+			loaded.runtime,
+			root,
+			SessionManager.inMemory(root),
+			{} as ModelRegistry,
+		);
+		for (let turn = 0; turn < 2; turn++) {
+			const result = await runner.emitBeforeAgentStart({messageType: "user", prompt: "request"}, {cwd: root, forceSystemPrompt: original});
+			expect(result?.systemPromptOptions.forceSystemPrompt).toBe(`${original}\nEarlier extension\n\n${reference}`);
+		}
+	});
+
+	it("wraps the common runtime factory persona hook, covering ordinary, resumed and subagent creation", () => {
+		const source = readFileSync(new URL("../../server/agent-service.ts", import.meta.url), "utf8");
+		const factory = source.slice(source.indexOf("private makeRuntimeFactory("));
+		expect(factory).toMatch(/pi\.on\(\s*"before_agent_start",\s*staleSafe\(withManagedReference\(\(event\) => \{/);
+		expect(factory).toContain('name: "pi-webui-persona"');
+		expect(MAPACHE_REFERENCE_PATH).toBe("/app/reference/mapache.md");
+	});
+});
diff --git a/tests/unit/managed-run-controller.test.ts b/tests/unit/managed-run-controller.test.ts
new file mode 100644
index 0000000..2ea983f
--- /dev/null
+++ b/tests/unit/managed-run-controller.test.ts
@@ -0,0 +1,153 @@
+import { describe, expect, it, vi } from "vitest";
+import { createManagedRunController } from "../../server/managed-run-controller.js";
+import type { ManagedModelCatalogResponse } from "../../server/managed-model-catalog.js";
+import type { ManagedRunInput } from "../../packages/keel/src/app/managed-run-bridge.js";
+
+function fixture() {
+	let onEvent: (event: unknown) => void = () => {};
+	let generation = 0;
+	const handle = {
+		conversationId: "request-c1",
+		submit: vi.fn(async () => {}),
+		cancel: vi.fn(async () => {}),
+		release: vi.fn(),
+	};
+	const engine = {
+		attach: vi.fn(async () => ({}) as any),
+		get: vi.fn(() => undefined),
+		isQuiesced: () => false,
+		managedAdmission: () => {
+			const admitted = generation;
+			return () => admitted === generation;
+		},
+		openManagedRun: vi.fn(async (_client: string, input: ManagedRunInput) => {
+			onEvent = input.onEvent;
+			return handle;
+		}),
+	};
+	const models = vi.fn(async (): Promise<ManagedModelCatalogResponse> => ({
+		ok: true,
+		models: [{ providerId: "provider", modelId: "family/model", name: "model", available: true }],
+		savedModelSelection: { providerId: "provider", modelId: "family/model" },
+	}));
+	const controller = createManagedRunController({ engine: () => engine, models });
+	return { controller, engine, models, handle, emit: (event: unknown) => onEvent(event), drain: () => generation++ };
+}
+const request = { runId: "run-1", prompt: "perform the task" };
+const final = {
+	type: "agent_end",
+	messages: [{ role: "assistant", stopReason: "stop", content: [{ type: "text", text: "done" }] }],
+};
+
+describe("managed run controller", () => {
+	it("reserves concurrent duplicates before setup and only completes on final SDK evidence", async () => {
+		const f = fixture();
+		await Promise.all([f.controller.startWorkspaceRequest(request), f.controller.startWorkspaceRequest(request)]);
+		expect(f.engine.openManagedRun).toHaveBeenCalledOnce();
+		expect(f.handle.submit).toHaveBeenCalledOnce();
+		expect(f.controller.workspaceRequestStatus(request.runId).status).toBe("running");
+		f.emit({ ...final, willRetry: true });
+		expect(f.controller.workspaceRequestStatus(request.runId).status).toBe("running");
+		f.emit({ type: "tool_execution_start", toolCallId: "tool-1" });
+		f.emit(final);
+		expect(f.controller.workspaceRequestStatus(request.runId).status).toBe("running");
+		f.emit({ type: "tool_execution_end", toolCallId: "tool-1" });
+		expect(f.controller.workspaceRequestStatus(request.runId)).toMatchObject({
+			status: "succeeded",
+			state: { finalAnswer: "done" },
+		});
+		await f.controller.startWorkspaceRequest(request);
+		expect(f.handle.submit).toHaveBeenCalledOnce();
+	});
+	it("does not start a canceled request after catalog setup resolves", async () => {
+		const f = fixture();
+		const catalog = await f.models();
+		let resolve!: (value: ManagedModelCatalogResponse) => void;
+		f.models.mockImplementation(
+			() =>
+				new Promise((done) => {
+					resolve = done;
+				}),
+		);
+		const start = f.controller.startWorkspaceRequest(request);
+		expect(await f.controller.cancelWorkspaceRequest(request.runId)).toMatchObject({ status: "canceled" });
+		resolve(catalog);
+		expect(await start).toMatchObject({ status: "canceled" });
+		expect(f.engine.openManagedRun).not.toHaveBeenCalled();
+	});
+	it("cancels a handle arriving after cancellation without dispatching its prompt", async () => {
+		const f = fixture();
+		let release!: () => void;
+		f.engine.openManagedRun.mockImplementation(async () => {
+			await new Promise<void>((resolve) => {
+				release = resolve;
+			});
+			return f.handle;
+		});
+		const start = f.controller.startWorkspaceRequest(request);
+		await vi.waitFor(() => expect(f.engine.openManagedRun).toHaveBeenCalledOnce());
+		await f.controller.cancelWorkspaceRequest(request.runId);
+		release();
+		expect(await start).toMatchObject({ status: "canceled" });
+		expect(f.handle.cancel).toHaveBeenCalledOnce();
+		expect(f.handle.submit).not.toHaveBeenCalled();
+	});
+	it("rejects stale saved models and missing provider authentication without dispatch", async () => {
+		const f = fixture();
+		f.models.mockResolvedValueOnce({
+			ok: true,
+			models: [],
+			savedModelSelection: { providerId: "stale", modelId: "missing" },
+		});
+		expect(await f.controller.startWorkspaceRequest(request)).toMatchObject({
+			ok: false,
+			error: "workspace_request_model_unavailable",
+		});
+		f.models.mockResolvedValueOnce({
+			ok: true,
+			models: [{ providerId: "p", modelId: "m", name: "m", available: false }],
+		});
+		expect(await f.controller.startWorkspaceRequest({ ...request, runId: "run-2", modelRef: "p/m" })).toMatchObject({
+			ok: false,
+			error: "workspace_request_provider_auth_required",
+		});
+		expect(f.handle.submit).not.toHaveBeenCalled();
+	});
+	it("does not revive admission after a drain/reopen cycle during setup", async () => {
+		const f = fixture();
+		const catalog = await f.models();
+		f.models.mockImplementation(async () => {
+			f.drain();
+			return catalog;
+		});
+		expect(await f.controller.startWorkspaceRequest(request)).toMatchObject({ ok: false, error: "server_quiesced" });
+		expect(f.engine.openManagedRun).not.toHaveBeenCalled();
+	});
+	it("records cancellation before interruption and retries failed cancellation without replay", async () => {
+		const f = fixture();
+		await f.controller.startWorkspaceRequest(request);
+		f.handle.cancel.mockRejectedValueOnce(new Error("secret-error"));
+		expect(await f.controller.cancelWorkspaceRequest(request.runId)).toMatchObject({
+			ok: false,
+			status: "canceled",
+			error: "managed_run_cancel_failed",
+		});
+		expect(await f.controller.cancelWorkspaceRequest(request.runId)).toMatchObject({ ok: true, status: "canceled" });
+		f.emit(final);
+		expect(f.controller.workspaceRequestStatus(request.runId).status).toBe("canceled");
+		expect(f.handle.submit).toHaveBeenCalledOnce();
+	});
+	it("allows one private automation run and reports unattended input requirements", async () => {
+		const f = fixture();
+		await f.controller.startAutomation(request);
+		expect(await f.controller.startAutomation({ ...request, runId: "another" })).toMatchObject({
+			ok: false,
+			error: "automation_run_busy",
+		});
+		f.emit({ type: "tool_execution_start", toolCallId: "question", toolName: "ask_user_question" });
+		await vi.waitFor(() => expect(f.handle.cancel).toHaveBeenCalledOnce());
+		f.emit({ type: "tool_execution_end", toolCallId: "question" });
+		f.emit(final);
+		expect(f.controller.automationStatus(request.runId).status).toBe("interaction_required");
+	});
+});
