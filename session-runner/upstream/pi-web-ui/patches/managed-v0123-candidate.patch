diff --git a/packages/keel/src/app/managed-drain.ts b/packages/keel/src/app/managed-drain.ts
new file mode 100644
index 0000000..9e1d417
--- /dev/null
+++ b/packages/keel/src/app/managed-drain.ts
@@ -0,0 +1,26 @@
+/** One deadline covers stop requests and verification, including hung adapters. */
+export async function drainManagedWriters(input: {
+	stop: readonly (() => void | Promise<unknown>)[];
+	isIdle(): boolean;
+	timeoutMs: number;
+}): Promise<boolean> {
+	const duration = Number.isFinite(input.timeoutMs) ? Math.max(1, input.timeoutMs) : 5000;
+	const deadline = Date.now() + duration;
+	let timer: ReturnType<typeof setTimeout> | undefined;
+	let expired = false;
+	const timeout = new Promise<false>((resolve) => {
+		timer = setTimeout(() => { expired = true; resolve(false); }, duration);
+	});
+	const drain = async (): Promise<boolean> => {
+		// Start every stop operation even when another throws synchronously.
+		const results = await Promise.allSettled(input.stop.map((stop) => Promise.resolve().then(stop)));
+		if (results.some((result) => result.status === "rejected")) return false;
+		while (!expired && Date.now() < deadline) {
+			if (input.isIdle()) return true;
+			await new Promise<void>((resolve) => setTimeout(resolve, Math.min(25, Math.max(1, deadline - Date.now()))));
+		}
+		return false;
+	};
+	try { return await Promise.race([drain().catch(() => false), timeout]); }
+	finally { expired = true; clearTimeout(timer); }
+}
diff --git a/packages/keel/src/app/managed-run-accounting.ts b/packages/keel/src/app/managed-run-accounting.ts
new file mode 100644
index 0000000..2238f40
--- /dev/null
+++ b/packages/keel/src/app/managed-run-accounting.ts
@@ -0,0 +1,43 @@
+import type { TurnCapableSession } from "../contracts/session.js";
+
+/** Engine-lifetime counters for the managed scheduler, independent of plugin listeners. */
+export class ManagedRunAccounting {
+	private completed = 0;
+	private readonly tools = new Set<Set<string>>();
+
+	completedTurns(): number { return this.completed; }
+	activeTools(): number {
+		let count = 0;
+		for (const calls of this.tools) count += calls.size;
+		return count;
+	}
+
+	/** Follow the opened session when it transfers between client registries. */
+	trackOpened(opened: { session: TurnCapableSession; dispose(): void }): void {
+		const release = this.track(opened.session);
+		const dispose = opened.dispose.bind(opened);
+		opened.dispose = () => {
+			try { dispose(); } finally { release(); }
+		};
+	}
+
+	track(session: TurnCapableSession): () => void {
+		const calls = new Set<string>();
+		this.tools.add(calls);
+		let closed = false;
+		const unsubscribe = session.subscribe?.((event) => {
+			if (closed || !event || typeof event !== "object") return;
+			const ev = event as { type?: string; toolCallId?: unknown; willRetry?: boolean };
+			if (ev.type === "agent_end" && !ev.willRetry) this.completed += 1;
+			if (typeof ev.toolCallId !== "string") return;
+			if (ev.type === "tool_execution_start") calls.add(ev.toolCallId);
+			if (ev.type === "tool_execution_end") calls.delete(ev.toolCallId);
+		});
+		return () => {
+			if (closed) return;
+			closed = true;
+			this.tools.delete(calls);
+			unsubscribe?.();
+		};
+	}
+}
diff --git a/packages/keel/src/app/managed-run-bridge.ts b/packages/keel/src/app/managed-run-bridge.ts
new file mode 100644
index 0000000..86caee1
--- /dev/null
+++ b/packages/keel/src/app/managed-run-bridge.ts
@@ -0,0 +1,121 @@
+import { Conversation } from "../kernel/conversation/index.js";
+import type { ClientRuntime } from "./client-runtime.js";
+
+export function trackManagedSetup<T>(pending: Set<Promise<unknown>>, flight: Promise<T>): Promise<T> {
+	pending.add(flight);
+	void flight.then(
+		() => pending.delete(flight),
+		() => pending.delete(flight),
+	);
+	return flight;
+}
+
+export interface ManagedRunInput {
+	title: string;
+	modelRef?: string;
+	onEvent(event: unknown): void;
+}
+
+export interface ManagedRunHandle {
+	conversationId: string;
+	sessionFile?: string;
+	submit(prompt: string): Promise<void>;
+	cancel(): Promise<void>;
+	release(): void;
+}
+
+/** Create a durable conversation without activating it. The existing core turn runner owns execution. */
+export async function openManagedRun(
+	runtime: ClientRuntime | undefined,
+	input: ManagedRunInput,
+	admitted: () => boolean,
+): Promise<ManagedRunHandle> {
+	if (!runtime || runtime.isDisposed()) throw new Error("managed_run_client_unavailable");
+	const sessions = runtime.options.sessions;
+	if (!sessions) throw new Error("managed_run_sessions_unavailable");
+	const check = () => {
+		if (!admitted() || runtime.isDisposed()) throw new Error("server_quiesced");
+	};
+	check();
+	const conversation = new Conversation({
+		id: `c-${runtime.registry.nextSeq()}`,
+		clientId: runtime.clientId,
+		cwd: runtime.cwd,
+		kind: "user",
+		createdAt: Date.now(),
+		title: input.title.slice(0, 160),
+		ephemeral: false,
+	});
+	runtime.registry.add(conversation);
+	let unsubscribe: (() => void) | undefined;
+	try {
+		const opened = await sessions.ensure(conversation);
+		await opened.ready;
+		check();
+		if (!opened.session.subscribe) throw new Error("managed_run_events_unavailable");
+		if (input.modelRef) {
+			const slash = input.modelRef.indexOf("/");
+			if (slash <= 0 || slash === input.modelRef.length - 1) throw new Error("automation_model_invalid");
+			const model = await runtime.options.resolveModel?.(
+				input.modelRef.slice(0, slash),
+				input.modelRef.slice(slash + 1),
+			);
+			check();
+			if (!model || !opened.session.setModel) throw new Error("automation_model_unavailable");
+			await opened.session.setModel(model);
+			check();
+		}
+		unsubscribe = opened.session.subscribe(input.onEvent);
+		let released = false;
+		const release = () => {
+			if (!released) {
+				released = true;
+				unsubscribe?.();
+			}
+		};
+		// Follow the opened session when its conversation is transferred to another client.
+		const dispose = opened.dispose.bind(opened);
+		opened.dispose = () => {
+			release();
+			dispose();
+		};
+		let submitted = false;
+		let canceled = false;
+		runtime.surface().conversations().markListed(conversation.id);
+		runtime.pushConversations();
+		return {
+			conversationId: conversation.id,
+			sessionFile: opened.sessionFile,
+			release,
+			async submit(prompt) {
+				check();
+				if (canceled || released || !conversation.acceptsTurns) throw new Error("managed_run_closed");
+				if (submitted) throw new Error("managed_run_already_submitted");
+				if (!prompt.trim()) throw new Error("automation_prompt_required");
+				submitted = true;
+				runtime.surface().conversations().markPrompted(conversation.id);
+				await runtime.turns.start(conversation, opened.session, prompt);
+			},
+			async cancel() {
+				canceled = true;
+				conversation.queues.clear();
+				runtime.options.cancelManagedQuestions?.(conversation.id);
+				opened.session.clearQueue?.();
+				if (!opened.session.abort && (conversation.phase === "running" || opened.session.isStreaming)) {
+					throw new Error("managed_run_abort_unavailable");
+				}
+				await opened.session.abort?.();
+				await runtime.turns.whenIdle(conversation.id);
+				if (opened.session.isStreaming || opened.session.isIdle === false) throw new Error("managed_run_still_active");
+			},
+		};
+	} catch (error) {
+		unsubscribe?.();
+		conversation.retire();
+		sessions.close(conversation.id);
+		conversation.finishRetire();
+		runtime.registry.remove(conversation.id);
+		runtime.pushConversations();
+		throw error;
+	}
+}
