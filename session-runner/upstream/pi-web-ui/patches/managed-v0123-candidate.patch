@@ -0,0 +1,33 @@
+import { realpathSync } from "node:fs";
+import { realpath } from "node:fs/promises";
+import { isInsideRoots } from "./path-boundary.js";
+import { isManaged } from "./managed.js";
+
+/** The single workspace root exposed by a managed runner. */
+export const MANAGED_WORKSPACE_ROOT = "/workspace";
+
+export function managedWorkspaceRoot(env: NodeJS.ProcessEnv = process.env): string | null {
+	return isManaged(env) ? MANAGED_WORKSPACE_ROOT : null;
+}
+
+/** Use the upstream boundary resolver, including symlinks and missing descendants. */
+export function pathWithinRoot(root: string, target: string): boolean {
+	return isInsideRoots(target, [root]);
+}
+
+/** Follow existing symlinks before accepting a managed workspace path. */
+export function isCanonicalPathWithinRootSync(root: string, target: string): boolean {
+	try {
+		return pathWithinRoot(realpathSync(root), realpathSync(target));
+	} catch {
+		return false;
+	}
+}
+
+export async function isCanonicalPathWithinRoot(root: string, target: string): Promise<boolean> {
+	try {
+		return pathWithinRoot(await realpath(root), await realpath(target));
+	} catch {
+		return false;
+	}
+}
diff --git a/server/managed.ts b/server/managed.ts
index 7cfcd19..c954659 100644
--- a/server/managed.ts
+++ b/server/managed.ts
@@ -1,21 +1,110 @@
-export const MANAGED_MESSAGES = [
-	"check_update",
-	"check_updates_all",
-	"install_pi_agent",
-	"update_engine",
-	"uninstall_engine",
-	"plugin_catalog_add",
-	"plugin_job",
-	"plugin_catalog_sync",
+/**
+ * managed — instances whose updates come from outside.
+ *
+ * pi-web-ui can update itself: the top bar shows an updates badge and a panel
+ * whose buttons run `npm i -g pi-web-ui@latest` in a visible terminal and
+ * restart the server. The plugin market installs plugins from the network the
+ * same way. On a developer's laptop both are conveniences.
+ *
+ * Behind a deploy pipeline they are not. A Docker image, a distribution
+ * package, or a release script that also checks the reverse proxy, the service
+ * unit and the environment variables a new version needs — for all of those,
+ * an in-app self-update leaves the machine in a state nothing describes, until
+ * the next real deploy silently undoes it. `PI_WEB_MANAGED=1` says "this
+ * instance is managed from outside": the update paths refuse, and the client
+ * stops offering them.
+ *
+ * Two rules kept this small:
+ *
+ * - **The server refuses, the client only hides.** Hiding a button while the
+ *   socket still accepts the message is hiding, not disabling: anything that
+ *   can open the WebSocket can still send it.
+ * - **Nothing else changes.** Chatting, plugins already installed, git,
+ *   terminal, settings are untouched — this switch is about who installs
+ *   software on the machine, not about what the interface can do.
+ */
+
+/** Requests that remain unavailable in a managed deployment. */
+export const MANAGED_MESSAGES = [] as const;
+
+export type ManagedMessage = (typeof MANAGED_MESSAGES)[number];
+
+/** Commands that would let the upstream app become a second credential owner. */
+export const MANAGED_CREDENTIAL_MESSAGES = [
+	"provider_oauth_start",
+	"provider_oauth_reply",
+	"provider_oauth_logout",
+	"set_provider_api_key",
+	"clear_provider_api_key",
+	"add_provider_key",
+	"activate_provider_key",
+	"remove_provider_key",
 ] as const;
 
+/**
+ * Whether this instance is managed from outside.
+ *
+ * Accepts the spellings people actually put in a systemd unit or a
+ * docker-compose file; anything else — including an empty variable — means no,
+ * so the default stays exactly what it is today.
+ */
 export function isManaged(env: NodeJS.ProcessEnv = process.env): boolean {
 	const v = (env.PI_WEB_MANAGED ?? "").trim().toLowerCase();
 	return v === "1" || v === "true" || v === "yes" || v === "on";
 }
 
+/**
+ * The image-owned adapter entry point used by managed Pi sessions. Keeping
+ * this as an explicit environment contract makes an unsupported/missing
+ * adapter a startup failure rather than an accidental second MCP path.
+ */
+export function managedMcpAdapterPath(env: NodeJS.ProcessEnv = process.env): string | null {
+	if (!isManaged(env)) return null;
+	const value = (env.PI_WEB_MCP_ADAPTER_PATH ?? "").trim();
+	return value || null;
+}
+
+/**
+ * The reason to send back, or null when the message may proceed.
+ *
+ * Returning the text rather than a boolean keeps the caller a single line and
+ * puts the explanation next to the rule it comes from — the user gets a
+ * sentence, not a silently dropped message.
+ */
 export function managedRefusal(type: string, managed: boolean): string | null {
 	if (!managed) return null;
 	if (!(MANAGED_MESSAGES as readonly string[]).includes(type)) return null;
 	return "This instance is managed: updates and plugin installs are handled by whoever deploys it (PI_WEB_MANAGED=1).";
 }
+
+/**
+ * Reject credential-bearing requests while leaving model metadata operations
+ * available. `save_model_config` and `fetch_models` are safe only when the
+ * request contains no new secret; the saved server-side secret/config is
+ * reused by those read/metadata paths.
+ */
+export function managedCredentialRefusal(type: string, managed: boolean, payload?: unknown): string | null {
+	if (!managed) return null;
+	if ((MANAGED_CREDENTIAL_MESSAGES as readonly string[]).includes(type)) return credentialRefusalText();
+
+	const message = payload && typeof payload === "object" ? (payload as Record<string, unknown>) : {};
+	if (type === "fetch_models" && hasNonEmptySecret(message.apiKey)) return credentialRefusalText();
+	if (type === "save_model_config") {
+		const config =
+			message.config && typeof message.config === "object" ? (message.config as Record<string, unknown>) : {};
+		if (hasNonEmptySecret(config.apiKey) || hasNonEmptyHeaders(config.headers)) return credentialRefusalText();
+	}
+	return null;
+}
+
+function hasNonEmptySecret(value: unknown): boolean {
+	return typeof value === "string" ? value.trim().length > 0 : value != null;
+}
+
+function hasNonEmptyHeaders(value: unknown): boolean {
+	return Boolean(value && typeof value === "object" && !Array.isArray(value) && Object.keys(value).length > 0);
+}
+
+function credentialRefusalText(): string {
+	return "This instance is managed: provider credentials, OAuth, and secret headers are handled by Mapache. Model selection and non-secret model metadata remain available.";
+}
diff --git a/server/mapache-provider-auth.ts b/server/mapache-provider-auth.ts
new file mode 100644
index 0000000..10d9b13
--- /dev/null
+++ b/server/mapache-provider-auth.ts
@@ -0,0 +1,30 @@
+import { readFileSync } from "node:fs";
+import { join } from "node:path";
+
+export const isMapacheCustomProvider = (id: string): boolean => /^custom-[a-z0-9][a-z0-9-]{0,62}$/.test(id);
+
+function endpoint(value: unknown): string {
+  const url = new URL(String(value || ""));
+  if (!["http:", "https:"].includes(url.protocol) || url.username || url.password || url.search || url.hash) {
+    throw new Error("Invalid custom provider endpoint");
+  }
+  return url.href.replace(/\/+$/, "");
+}
+
+/** Credentials are resolved only by provider ID and the endpoint saved in Mapache. */
+export function mapacheProviderKey(agentDir: string, id: string, baseUrl: string, api?: string): string {
+  if (!isMapacheCustomProvider(id) || api !== "openai-completions") {
+    throw new Error("Select an OpenAI-compatible connection saved in Mapache");
+  }
+  let credential: {key?: string; mapacheBaseUrl?: string} | undefined;
+  try {
+    credential = JSON.parse(readFileSync(join(agentDir, "auth.json"), "utf8"))[id];
+  } catch { /* Missing auth is reported without exposing file contents. */ }
+  if (!credential?.key || !credential.mapacheBaseUrl) {
+    throw new Error("Select this connection in Mapache Authentication and restart the workspace");
+  }
+  if (endpoint(baseUrl) !== endpoint(credential.mapacheBaseUrl)) {
+    throw new Error("Endpoint differs from this connection in Mapache Authentication. Update the connection there first");
+  }
+  return credential.key;
+}
diff --git a/server/model-admin.ts b/server/model-admin.ts
index 987dbc3..ab1aca7 100644
--- a/server/model-admin.ts
+++ b/server/model-admin.ts
@@ -15,9 +15,13 @@ import { enrichBatch, type EnrichLang } from "./model-enrich.js";
 import { resolveModelReasoningSpec } from "./reasoning-registry.js";
 import { pick, type ServerLang } from "./i18n.js";
 import { ProviderOAuthFlowManager } from "./provider-oauth-flow.js";
+import { isMapacheCustomProvider, mapacheProviderKey } from "./mapache-provider-auth.js";
+import { managedCredentialRefusal } from "./managed.js";
 
 export interface ModelAdminHost {
 	agentDir: string;
