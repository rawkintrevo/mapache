+	// The embedded parent rotates the signed agent URL and refreshes the scoped
+	// cookie. Reconnect the existing protocol socket after that cookie update;
+	// the iframe and all React conversation state stay mounted.
+	useEffect(() => {
+		const onAccessRenewed = () => {
+			if (timerRef.current) {
+				clearTimeout(timerRef.current);
+				timerRef.current = null;
+			}
+			retryRef.current = 0;
+			reconnectAfterAccessRef.current = true;
+			const ws = wsRef.current;
+			if (!ws || ws.readyState === WebSocket.CLOSED) {
+				reconnectAfterAccessRef.current = false;
+				connect();
+				return;
+			}
+			if (ws.readyState === WebSocket.OPEN) ws.close(1000, "agent_access_renewed");
+			if (ws.readyState === WebSocket.CONNECTING) {
+				ws.addEventListener("open", () => {
+					if (reconnectAfterAccessRef.current && wsRef.current === ws) ws.close(1000, "agent_access_renewed");
+				}, {once: true});
+			}
+		};
+		window.addEventListener(AGENT_ACCESS_RENEWED_EVENT, onAccessRenewed);
+		return () => window.removeEventListener(AGENT_ACCESS_RENEWED_EVENT, onAccessRenewed);
+	}, [connect]);
