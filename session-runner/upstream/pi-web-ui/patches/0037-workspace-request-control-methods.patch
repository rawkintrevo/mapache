+	private async requestClient(): Promise<ClientSession> {
+		const existing = this.uniqueClients()[0];
+		if (existing) return existing;
+		if (this.internalRequestClient) return this.internalRequestClient;
+		this.internalRequestClient = await ClientSession.create(
+			AgentService.INTERNAL_REQUEST_CLIENT_ID,
+			this.cwd,
+			this.stateStore,
+		);
+		return this.internalRequestClient;
+	}
+
+	async startWorkspaceRequest(input: {
+		runId: string;
+		ticketId?: string;
+		sourceWorkspaceId?: string;
+		conversationTitle?: string;
+		modelRef?: string;
+		prompt: string;
+	}): Promise<AutomationControlResponse> {
+		const runId = String(input?.runId ?? "").trim();
+		if (!runId) return { ok: false, error: "workspace_request_run_id_required" };
+		const existing = this.workspaceRequests.get(runId);
+		if (existing) return this.workspaceRequestResponse(existing);
+		if (this.quiesced) return { ok: false, error: "server_quiesced" };
+		let client: ClientSession;
+		try {
+			client = await this.requestClient();
+			const response = await client.startWorkspaceRequest(input);
+			if (!response.ok || !response.conversationId) return response;
+			const handle: WorkspaceRequestHandle = {
+				workspaceRequest: true,
+				runId,
+				client,
+				conversationId: response.conversationId,
+				state: createAutomationRunState(runId),
+				startPromise: null,
+				disposePromise: null,
+			};
+			this.workspaceRequests.set(runId, handle);
+			client.onAutomationEvent = (conversationId, event) => {
+				const request = [...this.workspaceRequests.values()].find((entry) => entry.conversationId === conversationId);
+				if (request) this.handleWorkspaceRequestEvent(request, conversationId, event);
+			};
+			this.reduceWorkspaceRequestEvent(handle, {
+				type: "started",
+				runId,
+				conversationId: response.conversationId,
+				eventId: "started",
+			});
+			return this.workspaceRequestResponse(handle);
+		} catch (error) {
+			return { ok: false, error: `workspace_request_start_failed:${automationError(error)}` };
+		}
+	}
+
+	workspaceRequestStatus(runId: string): AutomationControlResponse {
+		const handle = this.workspaceRequests.get(String(runId ?? "").trim());
+		return handle ? this.workspaceRequestResponse(handle) : { ok: false, error: "workspace_request_not_found" };
+	}
+
+	async cancelWorkspaceRequest(runId: string): Promise<AutomationControlResponse> {
+		const handle = this.workspaceRequests.get(String(runId ?? "").trim());
+		if (!handle) return { ok: false, error: "workspace_request_not_found" };
+		if (!handle.state.terminal) {
+			this.reduceWorkspaceRequestEvent(handle, {
+				type: "canceled",
+				runId: handle.runId,
+				conversationId: handle.conversationId,
+				error: "canceled",
+				eventId: `canceled:${handle.runId}`,
+			});
+			await handle.client.cancelWorkspaceRequest(handle.runId).catch(() => {});
+		}
+		return this.workspaceRequestResponse(handle);
+	}
