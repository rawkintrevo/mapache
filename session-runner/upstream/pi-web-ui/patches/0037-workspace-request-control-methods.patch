+	private reduceWorkspaceRequestEvent(handle: WorkspaceRequestHandle, event: AutomationRunEvent): void {
+		if (this.workspaceRequests.get(handle.runId) !== handle) return;
+		handle.state = reduceAutomationRunState(handle.state, event);
+	}
