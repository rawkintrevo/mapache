+	private handleWorkspaceRequestEvent(handle: WorkspaceRequestHandle, conversationId: string, event: AgentSessionEvent): void {
+		if (this.workspaceRequests.get(handle.runId) !== handle || conversationId !== handle.conversationId) return;
+		const base = { runId: handle.runId, conversationId };
+		const details = event as {
+			toolCallId?: string;
+			toolName?: string;
+			isError?: boolean;
+			willRetry?: boolean;
+			messages?: unknown[];
+		};
+		if (event.type === "tool_execution_start" && details.toolCallId) {
+			this.reduceWorkspaceRequestEvent(handle, {
+				...base,
+				type: "tool_start",
+				taskId: details.toolCallId,
+				eventId: `start:${details.toolCallId}`,
+			} as AutomationRunEvent);
+			return;
+		}
+		if (event.type === "tool_execution_end" && details.toolCallId) {
+			this.reduceWorkspaceRequestEvent(handle, {
+				...base,
+				type: "tool_end",
+				taskId: details.toolCallId,
+				isError: details.isError,
+				eventId: `end:${details.toolCallId}`,
+			} as AutomationRunEvent);
+			return;
+		}
+		if (event.type === "auto_retry_start") {
+			this.reduceWorkspaceRequestEvent(handle, {
+				...base,
+				type: "model_end",
+				error: String((event as { errorMessage?: unknown }).errorMessage ?? "model_retry"),
+				retryable: true,
+				eventId: `retry:${(event as { attempt?: number }).attempt ?? 0}`,
+			} as AutomationRunEvent);
+			return;
+		}
+		if (event.type === "agent_end") {
+			const messages = details.messages ?? [];
+			const lastAssistant = [...messages].reverse().find((message) => (message as { role?: unknown })?.role === "assistant") as
+				{ stopReason?: unknown; errorMessage?: unknown; content?: unknown } | undefined;
+			const stopReason = String(lastAssistant?.stopReason ?? "");
+			const isError = stopReason === "error" || stopReason === "aborted" || Boolean(lastAssistant?.errorMessage);
+			this.reduceWorkspaceRequestEvent(handle, {
+				...base,
+				type: "agent_end",
+				result: isError ? "error" : "success",
+				error: isError ? String(lastAssistant?.errorMessage ?? stopReason) : undefined,
+				answer: isError ? undefined : automationAnswer(lastAssistant),
+				willRetry: details.willRetry,
+				eventId: `agent-end:${handle.runId}:${handle.state.seenEventIds.length}`,
+			} as AutomationRunEvent);
+		}
+	}
