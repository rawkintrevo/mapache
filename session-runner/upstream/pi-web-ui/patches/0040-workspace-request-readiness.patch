diff --git a/tests/unit/workspace-request-models.test.ts b/tests/unit/workspace-request-models.test.ts
new file mode 100644
--- /dev/null
+++ b/tests/unit/workspace-request-models.test.ts
@@ -0,0 +1,76 @@
+import { afterEach, describe, expect, it, vi } from "vitest";
+import { AgentService, ClientSession } from "../../server/agent-service.js";
+
+type ServiceHarness = AgentService & Record<string, any>;
+
+function makeService(): ServiceHarness {
+	const service = Object.create(AgentService.prototype) as ServiceHarness;
+	Object.assign(service, {
+		clients: new Map(),
+		internalRequestClient: null,
+		internalRequestClientPromise: null,
+		cwd: "/workspace",
+		stateStore: {},
+	});
+	return service;
+}
+
+function modelClient(): ClientSession {
+	return {
+		modelCatalog: () => [{ providerId: "openai", modelId: "gpt-5", name: "GPT-5", available: true }],
+		savedModelSelection: () => null,
+	} as unknown as ClientSession;
+}
+
+afterEach(() => vi.restoreAllMocks());
+
+describe("browserless model discovery", () => {
+	it("shares one in-flight internal client initialization", async () => {
+		let release: (client: ClientSession) => void = () => {};
+		const creating = new Promise<ClientSession>((resolve) => { release = resolve; });
+		const create = vi.spyOn(ClientSession, "create").mockReturnValue(creating);
+		const service = makeService();
+
+		const first = service.workspaceRequestModels();
+		const second = service.workspaceRequestModels();
+		await Promise.resolve();
+		expect(create).toHaveBeenCalledOnce();
+		release(modelClient());
+
+		await expect(first).resolves.toMatchObject({ ok: true, models: [{ modelId: "gpt-5" }] });
+		await expect(second).resolves.toMatchObject({ ok: true, models: [{ modelId: "gpt-5" }] });
+	});
+
+	it("returns only safe client-initialization evidence", async () => {
+		vi.spyOn(ClientSession, "create").mockRejectedValue(new Error("client initialization failed: secret-token"));
+		const response = await makeService().workspaceRequestModels();
+
+		expect(response).toEqual({
+			ok: false,
+			error: "workspace_request_model_client_initialization_failed",
+			retryable: true,
+			stage: "client_initialization",
+		});
+		expect(JSON.stringify(response)).not.toContain("secret-token");
+	});
+});
