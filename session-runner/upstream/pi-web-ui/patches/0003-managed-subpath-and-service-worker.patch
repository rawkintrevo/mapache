-// PWA: register the service worker only in production builds so the Vite dev
-// server (live reload / HMR) is never intercepted or cached. The scope is
-// derived from the page URL (appBase), so sub-path deployments like /pi/ get
-// a worker scoped to the app root instead of the site root.
+// Managed embedding deliberately does not register a service worker. An old
+// pi-web-ui worker may still be present after an upgrade, so remove only a
+// registration that belongs to this app's exact subpath. In particular, do
+// not unregister Mapache's parent-scope worker.
 if (import.meta.env.PROD && "serviceWorker" in navigator) {
-	// Register after load so it never blocks first paint.
 	window.addEventListener("load", () => {
-		const base = appBase();
-		navigator.serviceWorker.register(`${base}sw.js`, { scope: base }).catch((err) => {
-			console.warn("Service worker registration failed:", err);
-		});
+		const appScope = new URL(appBase(), window.location.href).href;
+		const appWorker = new URL("sw.js", appScope).href;
+		navigator.serviceWorker.getRegistrations().then((registrations) => {
+			const owned = registrations.filter((registration) => {
+				if (registration.scope === appScope) return true;
+				return [registration.active, registration.waiting, registration.installing].some(
+					(worker) => worker?.scriptURL === appWorker,
+				);
+			});
+			return Promise.all(owned.map((registration) => registration.unregister()));
+		}).catch((err) => {
+			console.warn("Managed service worker cleanup failed:", err);
+		});
 	});
