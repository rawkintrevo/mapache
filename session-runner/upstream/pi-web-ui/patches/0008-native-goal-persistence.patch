+export interface ConversationGoalState {
+	goal: string;
+	reviewModel: string | null;
+	maxRounds: number;
+	locked: boolean;
+	round: number;
+	verdict: "pending" | "pass" | "fail";
+	status: string;
+	statusEn?: string;
+	feedback?: string;
+	savedAt: number;
+}
+
+function normalizeConversationGoal(value: unknown): ConversationGoalState | undefined {
+	if (!value || typeof value !== "object" || Array.isArray(value)) return undefined;
+	const raw = value as Partial<ConversationGoalState>;
+	if (typeof raw.goal !== "string" || !raw.goal.trim()) return undefined;
+	const maxRounds = Math.round(Number(raw.maxRounds));
+	const round = Math.round(Number(raw.round));
+	const verdict = raw.verdict === "pass" || raw.verdict === "fail" ? raw.verdict : "pending";
+	return {
+		goal: raw.goal.trim().slice(0, 20_000),
+		reviewModel:
+			typeof raw.reviewModel === "string" && raw.reviewModel.trim() ? raw.reviewModel.trim().slice(0, 300) : null,
+		maxRounds: Number.isFinite(maxRounds) && maxRounds > 0 ? Math.min(maxRounds, 50) : 0,
+		locked: raw.locked !== false,
+		round: Number.isFinite(round) && round > 0 ? Math.min(round, 100_000) : 0,
+		verdict,
+		status: typeof raw.status === "string" ? raw.status.slice(0, 2_000) : "",
+		...(typeof raw.statusEn === "string" ? { statusEn: raw.statusEn.slice(0, 2_000) } : {}),
+		...(typeof raw.feedback === "string" ? { feedback: raw.feedback.slice(0, 4_000) } : {}),
+		savedAt: typeof raw.savedAt === "number" && Number.isFinite(raw.savedAt) ? raw.savedAt : Date.now(),
