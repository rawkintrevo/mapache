+		...(typeof raw.statusEn === "string" ? { statusEn: raw.statusEn.slice(0, 2_000) } : {}),
+		...(typeof raw.feedback === "string" ? { feedback: raw.feedback.slice(0, 4_000) } : {}),
+		savedAt: typeof raw.savedAt === "number" && Number.isFinite(raw.savedAt) ? raw.savedAt : Date.now(),
