new file mode 100644
index 00000000..596696ad
--- /dev/null
+++ b/server/managed-reference.ts
@@ -0,0 +1,37 @@
+import { readFileSync } from "node:fs";
+import type { BeforeAgentStartEvent, BeforeAgentStartEventResult } from "@earendil-works/pi-coding-agent";
+import { isManaged } from "./managed.js";
+
+export const MAPACHE_REFERENCE_PATH = "/app/reference/mapache.md";
+
+type PromptHandler = (event: BeforeAgentStartEvent) => BeforeAgentStartEventResult | undefined;
+
+/** Wrap the persona hook, not APPEND_SYSTEM: custom composers may omit {{append}}.
+ * Each runtime (including resumed sessions and template subagents) loads its own
+ * image-owned reference. Never materialize instructions into the workspace.
+ */
+export function withManagedReference(
+	compose: PromptHandler,
+	env: NodeJS.ProcessEnv = process.env,
+	referencePath = MAPACHE_REFERENCE_PATH,
+): PromptHandler {
+	if (!isManaged(env)) return compose;
+	let reference: string;
+	try {
+		reference = readFileSync(referencePath, "utf8").trim();
+	} catch {
+		console.warn("[Mapache] Operating reference unavailable; keeping existing system prompt.");
+		return compose;
+	}
+	if (!reference) {
+		console.warn("[Mapache] Operating reference empty; keeping existing system prompt.");
+		return compose;
+	}
+	return (event) => {
+		const result = compose(event);
+		const prompt = result?.systemPrompt ?? event.systemPrompt;
+		// Repeated turns/reloads must not accumulate another copy.
+		if (prompt.includes(reference)) return result;
+		return { ...result, systemPrompt: `${prompt}\n\n${reference}` };
+	};
+}
diff --git a/server/managed-workspace.ts b/server/managed-workspace.ts
new file mode 100644
index 00000000..95325b76
--- /dev/null
+++ b/server/managed-workspace.ts
@@ -0,0 +1,34 @@
+import { realpathSync } from "node:fs";
+import { realpath } from "node:fs/promises";
+import { isAbsolute, relative, resolve, sep } from "node:path";
+import { isManaged } from "./managed.js";
+
+/** The single workspace root exposed by a managed runner. */
+export const MANAGED_WORKSPACE_ROOT = "/workspace";
+
+export function managedWorkspaceRoot(env: NodeJS.ProcessEnv = process.env): string | null {
+	return isManaged(env) ? MANAGED_WORKSPACE_ROOT : null;
+}
+
+/** Lexical containment check used together with the canonical checks below. */
+export function pathWithinRoot(root: string, target: string): boolean {
+	const rel = relative(resolve(root), resolve(target));
+	return rel === "" || (rel !== ".." && !rel.startsWith(`..${sep}`) && !isAbsolute(rel));
+}
+
+/** Follow existing symlinks before accepting a managed workspace path. */
+export function isCanonicalPathWithinRootSync(root: string, target: string): boolean {
+	try {
+		return pathWithinRoot(realpathSync(root), realpathSync(target));
+	} catch {
+		return false;
+	}
+}
+
+export async function isCanonicalPathWithinRoot(root: string, target: string): Promise<boolean> {
+	try {
+		return pathWithinRoot(await realpath(root), await realpath(target));
+	} catch {
+		return false;
+	}
+}
