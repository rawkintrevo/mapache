diff --git a/tests/unit/goal-persistence.test.ts b/tests/unit/goal-persistence.test.ts
new file mode 100644
index 00000000..e19b1b46
--- /dev/null
+++ b/tests/unit/goal-persistence.test.ts
@@ -0,0 +1,161 @@
+import { mkdtempSync, readFileSync, rmSync } from "node:fs";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import type { AgentSession } from "@earendil-works/pi-coding-agent";
+import { afterEach, describe, expect, it, vi } from "vitest";
+import { ClientStateStore, type ConversationGoalState } from "../../server/client-state.js";
+import { GoalService, type GoalConversation, type GoalHost } from "../../server/goal-service.js";
+import type { ServerMessage } from "../../server/protocol.js";
+
+const tempDirs: string[] = [];
+
+afterEach(() => {
+	for (const dir of tempDirs.splice(0)) rmSync(dir, { recursive: true, force: true });
+});
+
+function makeSavedGoal(): ConversationGoalState {
+	return {
+		goal: "Keep the native goal attached to this conversation",
+		reviewModel: "openai/gpt-5",
+		maxRounds: 3,
+		locked: false,
+		round: 2,
+		verdict: "fail",
+		status: "Needs one more pass",
+		statusEn: "Needs one more pass",
+		feedback: "Preserve the conversation identity.",
+		savedAt: 123,
+	};
+}
+
+function makeHarness(filePath: string, sessionId: string, clientId: string) {
+	const sent: string[] = [];
+	const session = {
+		sessionId,
+		sessionFile: `/var/lib/pi/sessions/${sessionId}.jsonl`,
+		isStreaming: false,
+		sendUserMessage: vi.fn(async (message: string) => {
+			sent.push(message);
+		}),
+	} as unknown as AgentSession;
+	const conv = {
+		id: "c1",
+		cwd: "/workspace",
+		session,
+		wizardRunning: false,
+		goalGeneration: 0,
+		goalReviewGeneration: 0,
+		goal: undefined,
+	} as unknown as GoalConversation;
+	const emitted: ServerMessage[] = [];
+	const flushSnapshot = vi.fn();
+	const host = {
+		clientId,
+		agentDir: "/tmp/agent",
+		stateStore: new ClientStateStore(filePath),
+		webUi: { cancelPendingDialogs: vi.fn() },
+		emit: (msg: ServerMessage) => emitted.push(msg),
+		flushSnapshot,
+		isDisposed: () => false,
+		quiesced: () => false,
+		quiesceBlocked: () => false,
+		activeConvId: () => conv.id,
+		activeConv: () => conv,
+		getConv: (id: string) => (id === conv.id ? conv : undefined),
+		conversations: () => [conv],
+		cwd: () => conv.cwd,
+		reviewSettings: () => ({ reviewPrompt: "", reviewDisabledSkills: [] }),
+		gitDiff: async () => "",
+		goalModeEnabled: () => true,
+		spawnRoleAgent: vi.fn(),
+		waitRoleAgent: vi.fn(),
+		sendRoleAgent: vi.fn(),
+		readRoleAgent: vi.fn(),
+		hasConv: () => true,
+	} as unknown as GoalHost;
+	const service = new GoalService(host);
+	conv.goal = service.makeGoalStatus();
+	return { conv, emitted, flushSnapshot, host, sent, service };
+}
+
+describe("native Goal persistence", () => {
+	it("stores display state in the global client-state entry and restores it for a new browser client", () => {
+		const dir = mkdtempSync(join(tmpdir(), "pi-web-ui-goal-persistence-"));
+		tempDirs.push(dir);
+		const filePath = join(dir, "client-state.json");
+		const saved = makeSavedGoal();
+		new ClientStateStore(filePath).saveConversationGoal("session:stable-1", saved);
+
+		const reloaded = new ClientStateStore(filePath);
+		expect(reloaded.getConversationGoal("session:stable-1")).toEqual(saved);
+		expect(reloaded.getConversationGoal("session:other")).toBeUndefined();
+		const disk = JSON.parse(readFileSync(filePath, "utf8")) as Record<string, unknown>;
+		expect(disk.__settings__).toMatchObject({ conversationGoals: { "session:stable-1": saved } });
+	});
+
+	it("restores a goal paused without starting review work, then resumes only on explicit action", async () => {
+		const dir = mkdtempSync(join(tmpdir(), "pi-web-ui-goal-restore-"));
+		tempDirs.push(dir);
+		const filePath = join(dir, "client-state.json");
+		new ClientStateStore(filePath).saveConversationGoal("session:stable-1", makeSavedGoal());
+
+		const { conv, flushSnapshot, sent, service } = makeHarness(filePath, "stable-1", "fresh-browser-client");
+		service.restoreGoalStatus(conv);
+
+		expect(conv.goal).toMatchObject({
+			conversationId: "c1",
+			goal: "Keep the native goal attached to this conversation",
+			reviewModel: "openai/gpt-5",
+			maxRounds: 3,
+			locked: false,
+			round: 2,
+			verdict: "fail",
+			paused: true,
+			reviewing: false,
+			wizard: { active: false, draft: "", step: 0 },
+		});
+
+		// Reconnect/history open must not kick the model or start the reviewer.
+		expect(service.onAgentEnd(conv, false)).toBeNull();
+		expect(sent).toHaveLength(0);
+
+		const start = vi.spyOn(service, "setGoal").mockResolvedValue(undefined);
+		await service.resumeGoal();
+		expect(conv.goal.paused).toBe(false);
+		expect(start).toHaveBeenCalledWith("Keep the native goal attached to this conversation", expect.objectContaining({targetConvId: "c1", reviewModel: "openai/gpt-5", maxRounds: 3}));
+		expect(sent).toHaveLength(0);
+	});
+
+	it("keeps restored state scoped to the stable upstream session identity", () => {
+		const dir = mkdtempSync(join(tmpdir(), "pi-web-ui-goal-scope-"));
+		tempDirs.push(dir);
+		const filePath = join(dir, "client-state.json");
+		new ClientStateStore(filePath).saveConversationGoal("session:stable-1", makeSavedGoal());
+
+		const first = makeHarness(filePath, "stable-1", "client-a");
+		const second = makeHarness(filePath, "stable-2", "client-b");
+		first.service.restoreGoalStatus(first.conv);
+		second.service.restoreGoalStatus(second.conv);
+
+		expect(first.conv.goal.goal).toBe("Keep the native goal attached to this conversation");
+		expect(second.conv.goal.goal).toBeNull();
+		expect(second.conv.goal.paused).toBe(false);
+	});
+
+	it("pauses a native goal and invalidates review work during quiesce", async () => {
+		const dir = mkdtempSync(join(tmpdir(), "pi-web-ui-goal-quiesce-"));
+		tempDirs.push(dir);
+		const harness = makeHarness(join(dir, "client-state.json"), "stable-1", "client-a");
+		await harness.service.setGoal("Finish the drain-safe goal", { autoStart: false });
+
+		await harness.service.quiesce();
+
+		expect(harness.conv.goal).toMatchObject({
+			goal: "Finish the drain-safe goal",
+			paused: true,
+			reviewing: false,
+			statusEn: "Goal paused while the server is stopping…",
+		});
+		expect(harness.conv.goalGeneration).toBe(2);
+	});
+});
diff --git a/tests/unit/managed-reference.test.ts b/tests/unit/managed-reference.test.ts
new file mode 100644
index 00000000..e667e2dc
--- /dev/null
+++ b/tests/unit/managed-reference.test.ts
@@ -0,0 +1,130 @@
+import { mkdtempSync, readFileSync, rmSync, writeFileSync } from "node:fs";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import { afterEach, beforeEach, describe, expect, it, vi } from "vitest";
+import {
+	DefaultResourceLoader,
+	ExtensionRunner,
+	SessionManager,
+	type BeforeAgentStartEvent,
+	type ModelRegistry,
+} from "@earendil-works/pi-coding-agent";
+import { MAPACHE_REFERENCE_PATH, withManagedReference } from "../../server/managed-reference.js";
+
+const reference = "# Mapache operating reference\nUse localhost:port in managed Chrome.";
+const original = "SYSTEM.md instructions\n\nAvailable tools: read\nProject AGENTS.md\nUser APPEND_SYSTEM.md";
+const event = (systemPrompt = original): BeforeAgentStartEvent => ({
+	type: "before_agent_start",
+	messageType: "user",
+	prompt: "user request",
+	systemPrompt,
+	systemPromptOptions: { cwd: root, selectedTools: [], hiddenTools: [], toolSnippets: {}, toolGuidelines: {}, promptGuidelines: [], appendSystemPrompt: "", sections: {}, contextFiles: [], skills: [] },
+});
+let root: string;
+let path: string;
+beforeEach(() => {
+	root = mkdtempSync(join(tmpdir(), "managed-reference-"));
+	path = join(root, "mapache.md");
+	writeFileSync(path, `\n${reference}\n`);
+});
+afterEach(() => {
+	vi.restoreAllMocks();
+	rmSync(root, { recursive: true, force: true });
+});
+
+function wrap(compose: Parameters<typeof withManagedReference>[0] = () => undefined) {
+	return withManagedReference(compose, { PI_WEB_MANAGED: "1" }, path);
+}
+
+describe("managed operating reference", () => {
+	it("appends exactly once while preserving all existing instructions and repeated turns", () => {
+		const handler = wrap();
+		const expected = `${original}\n\n${reference}`;
+		expect(handler(event())?.systemPrompt).toBe(expected);
+		expect(handler(event())?.systemPrompt).toBe(expected);
+		// No override needed when a chained prompt already includes the reference.
+		expect(handler(event(expected))).toBeUndefined();
+	});
+
+	it("appends after custom composition even when it omits the append token", () => {
+		const composed = "Custom composer instructions\nProject rules";
+		const message = { customType: "example", content: "retain", display: false };
+		const handler = wrap(() => ({ systemPrompt: composed, message }));
+		expect(handler(event())).toEqual({ systemPrompt: `${composed}\n\n${reference}`, message });
+	});
+
+	it.each(["append", "replace", "replace with SYSTEM.md", "empty template"])(
+		"preserves the existing %s template result",
+		(mode) => {
+			const composed = mode === "empty template" ? original : `${mode} role\nProject rules\nUser append`;
+			const handler = wrap(() => (mode === "empty template" ? undefined : { systemPrompt: composed }));
+			expect(handler(event())?.systemPrompt).toBe(`${composed}\n\n${reference}`);
+		},
+	);
+
+	it.each([{}, { PI_WEB_MANAGED: "0" }, { PI_WEB_MANAGED: "false" }])(
+		"does not read files or alter the composer when unmanaged/disabled: %j",
+		(env) => {
+			const compose = () => ({ systemPrompt: "unchanged" });
+			const warn = vi.spyOn(console, "warn").mockImplementation(() => {});
+			expect(withManagedReference(compose, env, join(root, "missing"))).toBe(compose);
+			expect(warn).not.toHaveBeenCalled();
+		},
+	);
+
+	it.each(["missing", "empty"])("keeps existing prompt for %s reference with a safe warning", (kind) => {
+		if (kind === "missing") rmSync(path);
+		else writeFileSync(path, " \n\t");
+		const warn = vi.spyOn(console, "warn").mockImplementation(() => {});
+		const compose = () => ({ systemPrompt: original });
+		expect(wrap(compose)).toBe(compose);
+		expect(warn).toHaveBeenCalledOnce();
+		expect(warn.mock.calls[0][0]).not.toContain(path);
+	});
+
+	it("loads fresh image content when a runtime is recreated/resumed", () => {
+		const first = wrap();
+		writeFileSync(path, "Updated image reference");
+		const resumed = wrap();
+		expect(first(event())?.systemPrompt).toContain(reference);
+		expect(resumed(event())?.systemPrompt).toBe(`${original}\n\nUpdated image reference`);
+	});
+
+	it("uses the supported SDK hook and preserves earlier extension instructions without a model call", async () => {
+		const loader = new DefaultResourceLoader({
+			cwd: root,
+			agentDir: root,
+			noExtensions: true,
+			noSkills: true,
+			noPromptTemplates: true,
+			extensionFactories: [
+				(pi) => {
+					pi.on("before_agent_start", (e) => ({ systemPrompt: `${e.systemPrompt}\nEarlier extension` }));
+					pi.on("before_agent_start", wrap());
+				},
+			],
+		});
+		await loader.reload();
+		const loaded = loader.getExtensions();
+		expect(loaded.errors).toEqual([]);
+		const runner = new ExtensionRunner(
+			loaded.extensions,
+			loaded.runtime,
+			root,
+			SessionManager.inMemory(root),
+			{} as ModelRegistry,
+		);
+		for (let turn = 0; turn < 2; turn++) {
+			const result = await runner.emitBeforeAgentStart({messageType: "user", prompt: "request"}, {cwd: root, forceSystemPrompt: original});
+			expect(result?.systemPromptOptions.forceSystemPrompt).toBe(`${original}\nEarlier extension\n\n${reference}`);
+		}
+	});
+
+	it("wraps the common runtime factory persona hook, covering ordinary, resumed and subagent creation", () => {
+		const source = readFileSync(new URL("../../server/agent-service.ts", import.meta.url), "utf8");
+		const factory = source.slice(source.indexOf("private makeRuntimeFactory("));
+		expect(factory).toContain('pi.on("before_agent_start", withManagedReference((event) => {');
+		expect(factory).toContain('name: "pi-webui-persona"');
+		expect(MAPACHE_REFERENCE_PATH).toBe("/app/reference/mapache.md");
+	});
+});
