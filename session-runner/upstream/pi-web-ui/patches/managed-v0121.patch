+} from "./automation-run-state.js";
+import type { AgentSessionEvent } from "@earendil-works/pi-coding-agent";
+import { ASK_USER_QUESTION_TOOL_NAME } from "./tool-manager.js";
+export interface AutomationControlResponse {
+	[key: string]: unknown;
+	ok: boolean;
+	runId?: string;
+	conversationId?: string;
+	status?: "submitted" | "running" | "succeeded" | "failed" | "canceled" | "interaction_required";
+	state?: AutomationRunState;
+	error?: string;
+}
+
+interface AutomationHandle {
+	runId: string;
+	client: ClientSession;
+	conversationId: string;
+	state: AutomationRunState;
+	startPromise: Promise<void> | null;
+	disposePromise: Promise<void> | null;
+}
+
+interface WorkspaceRequestHandle extends AutomationHandle {
+	workspaceRequest: true;
+}
+
+function automationError(error: unknown): string {
+	const message = String((error as Error)?.message ?? error ?? "automation_failed")
+		.replace(/\s+/g, " ")
+		.trim();
+	return message.slice(0, 160) || "automation_failed";
+}
+
+function automationStatus(state: AutomationRunState): AutomationControlResponse["status"] {
+	return state.terminal ?? (state.submitted ? "running" : "submitted");
+}
+
+function automationAnswer(message: { content?: unknown } | undefined): string | undefined {
+	const content = message?.content;
+	const text = typeof content === "string" ? content : Array.isArray(content)
+		? content.filter((part) => (part as { type?: unknown })?.type === "text")
+			.map((part) => String((part as { text?: unknown })?.text ?? ""))
+			.join("\n")
+		: "";
+	const answer = text.replace(/[\u0000-\u0008\u000b\u000c\u000e-\u001f\u007f]/g, "").trim();
+	return answer ? answer.slice(0, 32768) : undefined;
+}
+
+export interface QuiesceResult {
+	ok: boolean;
+	error?: string;
+	pid: number;
+	version: string;
+	cwd: string;
+	quiesced: boolean;
+	quiescedSince?: number;
+	connectedClients: number;
+	activeConversations: number;
+	activeTools: number;
+	pendingMessages: number;
+}
