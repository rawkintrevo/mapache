+	async workspaceRequestModels(): Promise<AutomationControlResponse & { models?: unknown[]; savedModelSelection?: { providerId: string; modelId: string } | null; retryable?: boolean; stage?: string }> {
+		try {
+			const client = await this.requestClient();
+			return { ok: true, models: client.modelCatalog(), savedModelSelection: client.savedModelSelection() };
+		} catch (error) {
+			const text = String((error as Error)?.message ?? error ?? "").toLowerCase();
+			const timedOut = /timeout|timed out|deadline/.test(text);
+			const fromClient = /client|initialize|initializ|create/.test(text);
+			return {
