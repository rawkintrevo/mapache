+	async resumeInterruptedWorkspaceRequests(
+		list: {sessionFile?: string; workspaceRequest?: boolean}[] | undefined,
+	): Promise<number> {
+		let resumed = 0;
+		for (const entry of list ?? []) {
+			if (!entry.workspaceRequest || !entry.sessionFile) continue;
+			const activeFile = this.conv.session.sessionFile;
+			if (!activeFile || resolve(activeFile) !== resolve(entry.sessionFile)) {
+				await this.switchSession(entry.sessionFile);
+			}
+			if (await this.resumeInterruptedWorkspaceRequest()) resumed++;
+		}
+		return resumed;
+	}
