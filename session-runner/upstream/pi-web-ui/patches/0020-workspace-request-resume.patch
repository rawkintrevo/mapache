+	async resumeInterruptedWorkspaceRequest(): Promise<boolean> {
+		const conv = this.conv;
+		if (conv.session.isStreaming || this.quiesceBlocked()) return false;
+		try {
+			if (!shouldResumeInterruptedWorkspaceRequest(conv.session.agent.state.messages)) return false;
