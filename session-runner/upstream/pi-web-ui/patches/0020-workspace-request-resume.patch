+			{
+				customType: "mapache-workspace-request-resume",
+				content: [{
+					type: "text",
+					text: "The workspace request wait was interrupted by a runner restart. Retry workspace_request_ask with the exact same payload and idempotencyKey from the preceding tool call, wait for its terminal result, and then answer the user. Do not submit with a new key.",
+				}],
+				display: false,
+			},
+			{ triggerTurn: true },
+		);
+		conv.promptedSinceActive = true;
+		conv.lastActiveAt = Date.now();
+		conv.lastSdkEventAt = Date.now();
