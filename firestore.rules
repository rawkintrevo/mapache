rules_version='2'

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function ownsWorkspace(workspaceId) {
      return signedIn() &&
        get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.ownerUid == request.auth.uid;
    }

    function validUserDocument(userId) {
      return userId == request.auth.uid &&
        request.resource.data.uid == request.auth.uid &&
        request.resource.data.keys().hasOnly([
          "uid",
          "email",
          "displayName",
          "photoURL",
          "providerIds",
          "createdAt",
          "lastSignedInAt",
          "updatedAt"
        ]);
    }

    match /users/{userId} {
      allow read: if signedIn() && userId == request.auth.uid;
      allow create: if signedIn() && validUserDocument(userId);
      allow update: if signedIn() &&
        resource.data.uid == request.auth.uid &&
        validUserDocument(userId);
      allow delete: if false;
    }

    function workspaceServerFields() {
      return [
        "automationMaxConcurrency",
        "runtimePolicy",
        "runtimePolicyRevision",
        "runtimeScheduleStatus",
        "runtimeScheduleNextEvent",
        "runtimeScheduleError",
        "runtimeScheduleManualPauseWindowKey",
        "runtimeScheduleLease",
        "runtimeScheduleLastAction",
        "runtimeScheduleReconciledAt",
        "runtimeProvider",
        "runtimeProviderDescriptor",
        "source",
        "imageKey",
        "status",
        "lifecycle",
        "deleted",
        "bucket",
        "storagePrefix",
        "workspaceStorageBucket",
        "workspaceStoragePrefix",
        "homePolicy",
        "agentRuntimeGeneration",
        "agentRuntimeSessionId",
        "agentRuntimeOperationId",
        "agentRuntimeState",
        "agentRuntimeBootInstanceId",
        "agentRuntimeBootHeartbeatAt",
        "agentRuntimeAuthorityState",
        "agentRuntimeCheckpoint",
        "agentRuntimeWorkspaceFiles",
        "syncWriterSessionId",
        "syncWriterLeaseId",
        "syncWriterLeaseUpdatedAt",
        "activeChromeSessionId",
        "activeChromeSessionState",
        "automationMainAdmissionSessionId",
        "automationMainAdmissionState",
        "sharedStorage",
        "sharedStorageState",
        "sharedStorageMigration",
        "sharedStorageRecovery"
      ];
    }

    // Presence is the fence, even if the record is incomplete. Only the
    // backend can write the fence collection.
    function workspaceMigrationFenced(workspaceId) {
      return exists(/databases/$(database)/documents/vmMigrationFences_v2/$(workspaceId));
    }

    match /vmMigrationFences_v2/{workspaceId} {
      allow read, write: if false;
    }

    match /workspaces/{workspaceId} {
      allow read: if signedIn() && resource.data.ownerUid == request.auth.uid;
      allow create: if signedIn() &&
        request.resource.data.ownerUid == request.auth.uid &&
        request.resource.data.userPath == "users/" + request.auth.uid &&
        !request.resource.data.keys().hasAny(workspaceServerFields()) &&
        !workspaceMigrationFenced(workspaceId);
      allow update: if signedIn() &&
        resource.data.ownerUid == request.auth.uid &&
        request.resource.data.ownerUid == request.auth.uid &&
        request.resource.data.userPath == "users/" + request.auth.uid &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(workspaceServerFields()) &&
        !workspaceMigrationFenced(workspaceId);
      allow delete: if signedIn() && resource.data.ownerUid == request.auth.uid &&
        !resource.data.keys().hasAny(["runtimeProvider", "runtimeProviderDescriptor"]) &&
        !workspaceMigrationFenced(workspaceId);

      match /automations/{automationId} {
        allow read: if ownsWorkspace(workspaceId);
        allow write: if false;
      }

      match /sessions/{sessionId} {
        allow read: if ownsWorkspace(workspaceId);
        allow write: if false;

        match /terminalHistory/{entryId} {
          allow read: if ownsWorkspace(workspaceId);
          allow write: if ownsWorkspace(workspaceId);
        }
      }
    }

    match /automationRuns/{runId} {
      allow read: if signedIn() && resource.data.ownerUid == request.auth.uid;
      allow write: if false;
    }
  }
}
