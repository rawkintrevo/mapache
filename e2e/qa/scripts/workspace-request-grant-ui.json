{
  "id": "script.workspaceRequestGrantUi",
  "title": "Save and revoke directional workspace request grants",
  "parameters": {
    "targetWorkspaceName": "qa-request-target-{{timestamp}}"
  },
  "actions": [
    {"type": "click", "role": "button", "name": "More workspace actions"},
    {"type": "click", "role": "menuitem", "name": "Workspace request access"},
    {"type": "waitForSnapshotText", "text": "Workspace request access", "timeoutMs": 10000},
    {"type": "select", "label": "TARGET WORKSPACE", "value": "{{targetWorkspaceName}}"},
    {"type": "click", "label": "DISCOVER TARGET"},
    {"type": "click", "label": "SUBMIT REQUESTS"},
    {"type": "click", "label": "READ RESULTS"},
    {"type": "click", "role": "button", "name": "Save grant"},
    {"type": "waitForNetwork", "requestUrlIncludes": "/request-grants/", "method": "PUT", "expectedStatus": 200, "timeoutMs": 15000},
    {"type": "waitForSnapshotText", "text": "Current grants", "timeoutMs": 10000},
    {"type": "click", "role": "button", "name": "Revoke"},
    {"type": "waitForNetwork", "requestUrlIncludes": "/request-grants/", "method": "DELETE", "expectedStatus": 200, "timeoutMs": 15000}
  ],
  "successSignals": [
    "The target workspace is selectable",
    "Save grant returns HTTP 200 and lists discover, submit, and read permissions",
    "Revoke returns HTTP 200 and removes the current grant"
  ]
}
