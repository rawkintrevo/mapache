{
  "id": "script.connectGoogleQaAccount",
  "title": "Connect the next deterministic Google test account",
  "actions": [
    {"type": "click", "role": "button", "name": "Add Google account"},
    {"type": "waitForSnapshotText", "text": "Workspace services", "timeoutMs": 5000},
    {"type": "click", "role": "checkbox", "name": "Gmail Google service"},
    {"type": "select", "label": "Access level", "value": "write"},
    {"type": "click", "role": "button", "name": "Start Google authorization"},
    {"type": "waitForSnapshotText", "text": "Complete Google authorization", "timeoutMs": 10000},
    {"type": "click", "role": "button", "name": "Close"},
    {"type": "waitForSnapshotText", "text": "Ready", "timeoutMs": 10000}
  ],
  "successSignals": [
    "The mocked OAuth popup completes and the account is bound to the selected workspace",
    "The selected Google service accepts the Read and write access level",
    "The saved account returns to the inspector as ready"
  ]
}
