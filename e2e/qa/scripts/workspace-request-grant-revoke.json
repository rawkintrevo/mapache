{
  "id": "script.workspaceRequestGrantRevoke",
  "title": "Revoke the current directional workspace request grant",
  "actions": [
    {"type": "click", "role": "button", "name": "More workspace actions"},
    {"type": "click", "role": "menuitem", "name": "Workspace request access"},
    {"type": "waitForSnapshotText", "text": "Current grants", "timeoutMs": 10000},
    {"type": "click", "role": "button", "name": "Revoke"},
    {"type": "waitForNetwork", "requestUrlIncludes": "/request-grants/", "method": "DELETE", "expectedStatus": 200, "timeoutMs": 15000},
    {"type": "click", "role": "button", "name": "Close"}
  ],
  "successSignals": [
    "Revoke returns HTTP 200 and removes the current grant"
  ]
}
