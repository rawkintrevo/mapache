{
  "id": "session.resource-sizing",
  "title": "Priced workspace sizing and expanded advanced resource controls",
  "description": "Verify workspace resource settings expose 6/8 vCPU and 16/24/32 GiB choices, estimate text, Custom inference, invalid-pair prevention, Cloud Run resize, and cleanup.",
  "baseUrl": "http://127.0.0.1:5173",
  "artifactsDir": "artifacts/qa/session-resource-sizing",
  "requires": {
    "cloudRun": "Creates and resizes a billable Cloud Run service"
  },
  "steps": [
    {"useCase": "cases/login.json"},
    {"useScript": "scripts/create-blank-workspace.json", "parameters": {"workspaceName": "qa-resource-sizing-ws-{{timestamp}}"}},
    {"useScript": "scripts/open-workspace-edit-modal.json"},
    {"assert": "snapshot-text", "expected": "Small selection: $0.0792/hr estimate"},
    {"type": "click", "text": "Advanced settings"},
    {"type": "select", "name": "workspaceCpu", "value": "4"},
    {"type": "select", "name": "workspaceMemory", "value": "16Gi"},
    {"type": "select", "name": "workspaceCpu", "value": "8"},
    {"type": "select", "name": "workspaceMemory", "value": "32Gi"},
    {"assert": "snapshot-text", "expected": "Custom selection"},
    {"assert": "resource-option-disabled", "name": "workspaceMemory", "value": "2Gi"},
    {"assert": "snapshot-text", "expected": "Custom selection: $0.7488/hr estimate"},
    {"type": "click", "role": "button", "name": "Save changes"},
    {"type": "waitForNetwork", "requestUrlIncludes": "/api/workspaces/", "method": "PATCH", "expectedStatus": 200, "timeoutMs": 30000},
    {"useScript": "scripts/open-workspace-edit-modal.json"},
    {"assert": "snapshot-text", "expected": "Custom 8 vCPU / 32 GiB"},
    {"assert": "snapshot-text", "expected": "Custom selection: $0.7488/hr estimate"},
    {"capture": "screenshot", "fileName": "session-resource-sizing-8-32.png"},
    {"type": "click", "role": "button", "name": "Cancel"},
    {"type": "click", "role": "button", "name": "Workspace power controls: stopped"},
    {"type": "click", "role": "menuitem", "name": "Start workspace"},
    {"type": "waitForSnapshotText", "text": "32 GIB", "timeoutMs": 180000},
    {"useScript": "scripts/open-workspace-edit-modal.json"},
    {"type": "click", "text": "Advanced settings"},
    {"type": "select", "name": "workspaceMemory", "value": "16Gi"},
    {"type": "select", "name": "workspaceCpu", "value": "4"},
    {"type": "select", "name": "workspaceMemory", "value": "2Gi"},
    {"type": "select", "name": "workspaceCpu", "value": "1"},
    {"assert": "snapshot-text", "expected": "Small selection: $0.0792/hr estimate"},
    {"type": "click", "role": "button", "name": "Save changes"},
    {"type": "waitForNetwork", "requestUrlIncludes": "/api/workspaces/", "method": "PATCH", "expectedStatus": 200, "timeoutMs": 30000},
    {"type": "waitForNetwork", "requestUrlIncludes": "/resize", "method": "POST", "expectedStatus": 202, "timeoutMs": 180000},
    {"capture": "screenshot", "fileName": "session-resource-sizing.png"},
    {"capture": "console"},
    {"capture": "network"},
    {"useScript": "scripts/delete-selected-workspace.json"}
  ]
}
