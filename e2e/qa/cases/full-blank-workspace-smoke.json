{
  "id": "full.blank-workspace-smoke",
  "title": "Full blank workspace smoke",
  "description": "Broad blank-workspace smoke covering login, workspace creation, the sole pi-chrome session path, embedded Agent readiness, navbar connection controls, and cleanup.",
  "baseUrl": "http://127.0.0.1:5173",
  "artifactsDir": "artifacts/qa/full.blank-workspace-smoke",
  "requires": {
    "cloudRun": "Creates a billable Cloud Run service"
  },
  "steps": [
    {"useCase": "cases/login.json"},
    {"useScript": "scripts/create-blank-workspace.json", "parameters": {"workspaceName": "qa-full-ws-{{timestamp}}"}},
    {"useScript": "scripts/create-session.json", "parameters": {"sessionName": "qa-full-session-{{timestamp}}"}},
    {"useScript": "scripts/wait-session-running.json"},
    {"assert": "agent-ui-ready", "expected": "The new session uses the marked pi-chrome path and the embedded Agent reports readiness."},
    {"assert": "button-present", "name": "Manage Pi Auth"},
    {"assert": "button-present", "name": "Manage MCP servers"},
    {"assert": "button-present", "name": "Manage Google Workspace"},
    {"assert": "snapshot-not-text", "expected": "Files"},
    {"assert": "snapshot-not-text", "expected": "Git"},
    {"assert": "snapshot-not-text", "expected": "Goals"},
    {"assert": "snapshot-not-text", "expected": "Chat"},
    {"capture": "console"},
    {"capture": "network"},
    {"capture": "screenshot", "fileName": "full-smoke.png"},
    {"useScript": "scripts/delete-selected-session.json"},
    {"useScript": "scripts/delete-selected-workspace.json"}
  ]
}
