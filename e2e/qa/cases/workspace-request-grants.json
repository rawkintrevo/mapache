{
  "id": "workspace.request-grants",
  "title": "Configure directional workspace request grants",
  "description": "Create two disposable same-owner workspaces, open the owner grant UI, select the sibling target, save independent permissions, and revoke the grant.",
  "baseUrl": "http://127.0.0.1:5173",
  "artifactsDir": "artifacts/qa/workspace.request-grants",
  "steps": [
    {"useCase": "cases/login.json"},
    {"useScript": "scripts/create-blank-workspace.json", "parameters": {"workspaceName": "qa-request-source-{{timestamp}}", "workspaceEnv": "QA_CASE=workspace-request-grants"}},
    {"useScript": "scripts/create-blank-workspace.json", "parameters": {"workspaceName": "qa-request-target-{{timestamp}}", "workspaceEnv": "QA_CASE=workspace-request-grants"}},
    {"type": "select", "label": "Workspace", "value": "qa-request-source-{{timestamp}}"},
    {"type": "click", "role": "button", "name": "More workspace actions"},
    {"type": "click", "role": "menuitem", "name": "Workspace request access"},
    {"type": "assert", "name": "workspace-request-grant-dialog", "expected": "Accessible dialog titled Workspace request access with the target workspace selector and five independent operation checkboxes."},
    {"type": "select", "label": "Target workspace", "value": "qa-request-target-{{timestamp}}"},
    {"type": "click", "label": "Discover target"},
    {"type": "click", "label": "Submit requests"},
    {"type": "click", "label": "Read results"},
    {"type": "click", "role": "button", "name": "Save grant"},
    {"type": "waitForNetwork", "requestUrlIncludes": "/request-grants/", "method": "PUT", "expectedStatus": 200, "timeoutMs": 15000},
    {"type": "assert", "name": "workspace-request-grant-saved", "expected": "Current grants lists the target with discover, submit, and read permissions."},
    {"type": "click", "role": "button", "name": "Revoke"},
    {"type": "waitForNetwork", "requestUrlIncludes": "/request-grants/", "method": "DELETE", "expectedStatus": 200, "timeoutMs": 15000},
    {"type": "assert", "name": "workspace-request-grant-revoked", "expected": "Current grants shows no workspace request grants."},
    {"capture": "screenshot", "fileName": "workspace-request-grants.png"}
  ]
}
