{
  "id": "automation.management",
  "title": "Workspace automation management and storage gating",
  "description": "Exercise the workspace-scoped Automations surface, disabled-save path, schedule/timezone controls, concurrency setting, and owner-safe cleanup.",
  "baseUrl": "http://127.0.0.1:5173",
  "artifactsDir": "artifacts/qa/automation.management",
  "steps": [
    {"useCase": "cases/login.json"},
    {"useScript": "scripts/create-blank-workspace.json", "parameters": {"workspaceName": "qa-automation-{{timestamp}}", "workspaceEnv": "QA_CASE=automation-management"}},
    {"type": "click", "role": "button", "name": "Automations"},
    {"assert": "snapshot-text", "expected": "Prepare automations"},
    {"assert": "snapshot-text", "expected": "Legacy storage"},
    {"type": "click", "role": "button", "name": "Prepare automations"},
    {"type": "waitForNetwork", "requestUrlIncludes": "/automation-storage/prepare", "method": "POST", "expectedStatus": 202, "timeoutMs": 20000},
    {"assert": "snapshot-text", "expected": "Preparing storage"},
    {"type": "click", "role": "button", "name": "New automation"},
    {"type": "fill", "label": "Name", "value": "Safe fixture automation {{timestamp}}"},
    {"type": "fill", "label": "Instructions", "value": "Write one unique fixture file; do not publish or send external messages."},
    {"type": "select", "label": "Schedule type", "value": "advanced"},
    {"type": "fill", "label": "Cron expression", "value": "17 14 * * 2"},
    {"type": "fill", "label": "Timezone", "value": "America/Chicago"},
    {"type": "click", "role": "button", "name": "Save automation"},
    {"type": "waitForNetwork", "requestUrlIncludes": "/automations", "method": "POST", "expectedStatus": 201, "timeoutMs": 15000},
    {"assert": "snapshot-text", "expected": "Disabled"},
    {"type": "fill", "label": "Maximum concurrent automations", "value": "2"},
    {"type": "click", "role": "button", "name": "Save limit"},
    {"type": "waitForNetwork", "requestUrlIncludes": "/automation-settings", "method": "PATCH", "expectedStatus": 200, "timeoutMs": 15000},
    {"type": "click", "role": "button", "name": "Run history"},
    {"assert": "snapshot-text", "expected": "Run history"},
    {"capture": "screenshot", "fileName": "automation-management.png"},
    {"capture": "console"},
    {"capture": "network"},
    {"useScript": "scripts/delete-selected-workspace.json"}
  ]
}
