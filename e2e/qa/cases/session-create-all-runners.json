{
  "id": "session.create-all-runners",
  "title": "Create the supported gcp-runner session",
  "description": "Log in, create a blank workspace, start its server-selected gcp-runner session, then delete the workspace and its session resources.",
  "baseUrl": "http://127.0.0.1:5173",
  "artifactsDir": "artifacts/qa/session.create-all-runners",
  "requires": {
    "cloudRun": "Creates one billable gcp-runner Cloud Run service"
  },
  "steps": [
    {"useCase": "cases/login.json"},
    {"useScript": "scripts/create-blank-workspace.json", "parameters": {"workspaceName": "qa-all-runners-ws-{{timestamp}}"}},
    {"type": "click", "role": "button", "name": "Workspace power controls: stopped"},
    {"type": "click", "role": "menuitem", "name": "Start workspace"},
    {"assert": "network-status", "requestUrlIncludes": "/sessions", "method": "POST", "expectedStatus": 201},
    {"capture": "screenshot", "fileName": "gcp-runner-session.png"},
    {"useScript": "scripts/delete-selected-workspace.json"}
  ]
}
