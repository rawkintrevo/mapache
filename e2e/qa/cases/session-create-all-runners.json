{
  "id": "session.create-all-runners",
  "title": "Create the supported pi-chrome session",
  "description": "Log in, create a blank workspace, then create and clean up one pi-chrome session.",
  "baseUrl": "http://127.0.0.1:5173",
  "artifactsDir": "artifacts/qa/session.create-all-runners",
  "requires": {
    "cloudRun": "Creates one billable pi-chrome Cloud Run service"
  },
  "steps": [
    {"useCase": "cases/login.json"},
    {"useScript": "scripts/create-blank-workspace.json", "parameters": {"workspaceName": "qa-all-runners-ws-{{timestamp}}"}},
    {"useScript": "scripts/create-session.json", "parameters": {"sessionName": "qa-pi-chrome-{{timestamp}}", "imageKey": "pi-chrome", "cpu": "1", "memory": "2Gi"}},
    {"assert": "network-status", "requestUrlIncludes": "/sessions", "method": "POST", "expectedStatus": 201},
    {"assert": "snapshot-any-text", "expectedAny": ["Terminal access is not ready.", "Terminal qa-pi-chrome"]},
    {"capture": "screenshot", "fileName": "pi-chrome-session.png"},
    {"useScript": "scripts/delete-selected-session.json"},

    {"useScript": "scripts/delete-selected-workspace.json"}
  ]
}
