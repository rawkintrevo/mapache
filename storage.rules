rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function ownsPrefix(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    match /workspaces/{uid}/{allPaths=**} {
      allow read: if ownsPrefix(uid);
    }

    match /workspaces/{uid} {
      allow write: if ownsPrefix(uid);
    }

    match /workspaces/{uid}/{workspaceKey}/{allPaths=**} {
      allow write: if ownsPrefix(uid) && !firestore.exists(
        /databases/(default)/documents/vmMigrationStorageFences_v2/$(bucket)/owners/$(uid)/prefixes/$(workspaceKey)
      );
    }
  }
}
