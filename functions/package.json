{
  "name": "functions",
  "description": "Cloud Functions for Firebase",
  "scripts": {
    "prelint": "node googleMcpTokenBroker.service.test.js",
    "lint": "for file in *.js; do case \"$file\" in *.test.js) ;; *) node --check \"$file\" || exit $?;; esac; done",
    "pretest": "node googleMcpTokenBroker.service.test.js",
    "test": "for file in *.test.js; do node \"$file\" || exit $?; done && node github.service.js",
    "serve": "firebase emulators:start --only functions",
    "shell": "firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log"
  },
  "engines": {
    "node": "24"
  },
  "main": "index.js",
  "dependencies": {
    "firebase-admin": "^13.6.0",
    "firebase-functions": "^7.0.0",
    "google-auth-library": "^10.7.0"
  },
  "private": true
}
